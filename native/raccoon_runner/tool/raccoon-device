def swift_entry_of(plugins):
    return {'name': 'swift packages', 'key': 'swiftpm-%s' % hashlib.sha256(
        '\n'.join(sorted(p['key'] for p in plugins)).encode('utf-8', 'surrogateescape')).hexdigest()[:16]}


def family(name, names):
    """[name] and those of [names] tied to it through their pubspecs,
    either way: what shares its native code."""
    found, pending = set(), [name]
    while pending:
        current = pending.pop()
        if current in found:
            continue
        found.add(current)
        pending.extend(dependencies(by_name.get(current, '')) & set(names))
        pending.extend(n for n in names if current in dependencies(by_name.get(n, '')))
    return found


# The set of Swift packages the app has, before any is left out: what a
# plugin was left out of. A conflict or a family is about the others too,
# so a change to the set (the other side of a conflict gone, a member
# upgraded) tries it again (#203).
swift_set = hashlib.sha256('\n'.join(sorted(p['key'] for p in swift)).encode(
    'utf-8', 'surrogateescape')).hexdigest()[:16]


