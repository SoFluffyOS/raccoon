#!/usr/bin/env bash
# The commands behind the "raccoon" entry in Flutter's custom_devices.json.
#
#   raccoon-device ping
#   raccoon-device install [--instance N] <localPath> <appName>
#   raccoon-device uninstall [--instance N] <appName>
#   raccoon-device run [--instance N] <appName> [engine switches]
#
# install copies the app bundle the tool built (build/flutter_assets) into the
# runtime's app store; run starts raccoon_runner serve on it and leaves the
# engine's log lines on stdout, where the tool reads the VM service URI, and
# keeps a timestamped copy of the run's output in the app's data directory.
#
# --instance N (the "raccoon-N" device) keeps the same project apart from its
# first run: socket, app store and data directory are named <appName>@N, so
# one project can run at two sizes side by side.
set -euo pipefail

ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
# The binary sits under build/ in a checkout and at the root of a release
# archive (tool/package.sh); RACCOON_RUNNER overrides both.
if [ -n "${RACCOON_RUNNER:-}" ]; then
  RUNNER="$RACCOON_RUNNER"
elif [ -x "$ROOT/build/raccoon_runner" ]; then
  RUNNER="$ROOT/build/raccoon_runner"
else
  RUNNER="$ROOT/raccoon_runner"
fi
APPS="${XDG_DATA_HOME:-$HOME/.local/share}/raccoon/apps"
# What an app keeps across runs (its shared preferences); install replaces the
# app's bundle but leaves this.
DATA="${XDG_DATA_HOME:-$HOME/.local/share}/raccoon/data"

# The socket directory must be the one raccoon_runtime's RunnerDiscovery
# watches: the XDG runtime directory on Linux, the user's temporary directory
# on macOS. The SDK keeps one macOS engine directory for both architectures.
case "$(uname -s)" in
  Darwin)
    TEMP="${TMPDIR:-/tmp}"
    SOCKETS="${TEMP%/}/raccoon"
    SDK_ENGINE=darwin-x64
    ;;
  Linux)
    SOCKETS="${XDG_RUNTIME_DIR:-/tmp}/raccoon"
    case "$(uname -m)" in
      x86_64) SDK_ENGINE=linux-x64 ;;
      aarch64|arm64) SDK_ENGINE=linux-arm64 ;;
      *) echo "unsupported architecture $(uname -m)" >&2; exit 1 ;;
    esac
    ;;
  *) echo "unsupported system $(uname -s)" >&2; exit 1 ;;
esac

sdk_icu() {
  local root
  if [ -n "${FLUTTER_ROOT:-}" ] && [ -d "$FLUTTER_ROOT/bin/cache" ]; then
    root="$FLUTTER_ROOT"
  else
    local flutter
    flutter="$(readlink -f "$(command -v flutter)")"
    root="$(cd "$(dirname "$flutter")/.." && pwd)"
  fi
  echo "$root/bin/cache/artifacts/engine/$SDK_ENGINE/icudtl.dat"
}

# The key an app's socket, store and data are named by: the app name, with
# @N for an instance other than the first.
app_key() {
  if [ "$INSTANCE" = "1" ]; then echo "$1"; else echo "$1@$INSTANCE"; fi
}

# Prefixes each line with the time of day, to the millisecond.
stamp() {
  perl -pe 'BEGIN { $| = 1 } use Time::HiRes qw(time); my $t = time; my @l = localtime($t);
            $_ = sprintf("%02d:%02d:%06.3f ", $l[2], $l[1], $l[0] + $t - int($t)) . $_'
}

verb="${1:-}"; shift || true
INSTANCE=1
if [ "${1:-}" = "--instance" ]; then
  INSTANCE="$2"; shift 2
fi


# The window plugins stay the runner's own: their window is the client's pane.
VIRTUAL_PLUGINS="desktop_window window_manager window_size screen_retriever"

# The plugin-facing library and its headers: beside the runner in an archive,
# in build/ and third_party/ in a checkout.
plugin_library() {
  local dir
  dir="$(dirname "$RUNNER")"
  [ -f "$dir/libflutter_linux_gtk.so" ] && echo "$dir/libflutter_linux_gtk.so"
}
plugin_headers() {
  if [ -d "$ROOT/include/flutter_linux" ]; then
    echo "$ROOT/include"
  elif [ -d "$ROOT/third_party/flutter_linux/flutter/shell/platform/linux/public/flutter_linux" ]; then
    echo "$ROOT/third_party/flutter_linux/flutter/shell/platform/linux/public"
  fi
}

# Builds a project's native plugins into |out| and writes |out|/manifest.json
# for the runner's --plugins. The plugins are the resolved packages
# (.dart_tool/package_config.json) whose pubspec names a Linux pluginClass,
# as the Flutter tool finds them; built in one CMake project with what the
# desktop template gives a plugin. When it cannot, says why and leaves no
# manifest; the app then sees no plugin.
build_plugins() {
  local project="$1" out="$2" lib headers need count
  rm -rf "$out"
  [ "$(uname -s)" = Linux ] || return 0
  [ -f "$project/.dart_tool/package_config.json" ] || return 0
  lib="$(plugin_library || true)"
  headers="$(plugin_headers || true)"
  if [ -z "$lib" ] || [ -z "$headers" ]; then
    echo "raccoon-device: this runner has no plugin library; native plugins skipped" >&2
    return 0
  fi
  for need in cmake ninja python3 pkg-config; do
    if ! command -v "$need" >/dev/null; then
      echo "raccoon-device: no $need; native plugins skipped" >&2
      return 0
    fi
  done
  if ! pkg-config --exists gtk+-3.0; then
    echo "raccoon-device: no gtk+-3.0 development files; native plugins skipped" >&2
    return 0
  fi
  mkdir -p "$out"
  count="$(python3 - "$project/.dart_tool/package_config.json" "$out" "$lib" "$headers" "$VIRTUAL_PLUGINS" <<'PY'
import json, os, re, sys
from urllib.parse import unquote, urlparse
config, out, lib, headers, virtual = sys.argv[1:6]
virtual = set(virtual.split())
dart_tool = os.path.dirname(os.path.abspath(config))
plugins = []
for package in json.load(open(config)).get('packages', []):
    uri = package.get('rootUri', '')
    if uri.startswith('file://'):
        root = unquote(urlparse(uri).path)
    else:
        root = os.path.normpath(os.path.join(dart_tool, uri))
    if os.path.isfile(os.path.join(root, 'pubspec.yaml')):
        plugins.append({'name': package['name'], 'path': root})
lines = [
    'cmake_minimum_required(VERSION 3.14)',
    'project(raccoon_plugins LANGUAGES CXX)',
    'set(CMAKE_BUILD_TYPE Release)',
    'function(APPLY_STANDARD_SETTINGS TARGET)',
    '  target_compile_features(${TARGET} PUBLIC cxx_std_14)',
    '  target_compile_options(${TARGET} PRIVATE -Wall -Werror)',
    '  target_compile_options(${TARGET} PRIVATE "$<$<NOT:$<CONFIG:Debug>>:-O3>")',
    '  target_compile_definitions(${TARGET} PRIVATE "$<$<NOT:$<CONFIG:Debug>>:NDEBUG>")',
    'endfunction()',
    'find_package(PkgConfig REQUIRED)',
    'pkg_check_modules(GTK REQUIRED IMPORTED_TARGET gtk+-3.0)',
    'pkg_check_modules(GLIB REQUIRED IMPORTED_TARGET glib-2.0)',
    'pkg_check_modules(GIO REQUIRED IMPORTED_TARGET gio-2.0)',
    'add_library(flutter INTERFACE)',
    'target_include_directories(flutter INTERFACE "%s")' % headers,
    'target_link_libraries(flutter INTERFACE "%s" PkgConfig::GTK PkgConfig::GLIB PkgConfig::GIO)' % lib,
]
wanted = []
for plugin in plugins:
    name, path = plugin['name'], plugin['path']
    if name in virtual:
        continue
    pubspec = open(os.path.join(path, 'pubspec.yaml')).read()
    if not re.search(r'^\s+plugin:\s*$', pubspec, re.M):
        continue
    found = re.search(r'^([ \t]*)linux:[ \t]*\n', pubspec, re.M)
    block = []
    if found:
        indent = len(found.group(1))
        for line in pubspec[found.end():].splitlines():
            if not line.strip():
                continue
            if len(line) - len(line.lstrip()) <= indent:
                break
            block.append(line)
    cls = re.search(r'pluginClass:\s*(\w+)', '\n'.join(block))
    if cls is None:
        continue  # an FFI plugin, or Dart only on Linux: nothing to register
    symbol = re.sub(r'(?<!^)(?=[A-Z])', '_', cls.group(1)).lower() + '_register_with_registrar'
    lines.append('add_subdirectory("%s" "plugins/%s")' % (os.path.join(path, 'linux'), name))
    wanted.append({'name': name, 'symbol': symbol})
open(os.path.join(out, 'CMakeLists.txt'), 'w').write('\n'.join(lines) + '\n')
json.dump(wanted, open(os.path.join(out, 'wanted.json'), 'w'))
print(len(wanted))
PY
)"
  if [ "$count" = 0 ]; then
    rm -rf "$out"
    return 0
  fi
  if ! cmake -S "$out" -B "$out/build" -G Ninja > "$out/build.log" 2>&1 ||
     ! cmake --build "$out/build" >> "$out/build.log" 2>&1; then
    echo "raccoon-device: native plugins did not build; see $out/build.log" >&2
    return 0
  fi
  python3 - "$out" <<'PY'
import glob, json, os, sys
out = sys.argv[1]
entries = []
for plugin in json.load(open(os.path.join(out, 'wanted.json'))):
    libs = glob.glob(os.path.join(out, 'build', 'plugins', plugin['name'], '*.so'))
    if libs:
        entries.append({'name': plugin['name'], 'library': libs[0], 'symbol': plugin['symbol']})
json.dump({'plugins': entries}, open(os.path.join(out, 'manifest.json'), 'w'), indent=1)
print('raccoon-device: %d native plugins built: %s' % (len(entries), ', '.join(e['name'] for e in entries)), file=sys.stderr)
PY
}

case "$verb" in
  ping)
    test -x "$RUNNER"
    ;;
  install)
    local_path="$1"; key="$(app_key "$2")"
    rm -rf "$APPS/$key"
    mkdir -p "$APPS/$key"
    cp -r "$local_path" "$APPS/$key/flutter_assets"
    # The project is two levels above its bundle; its native plugins are
    # built for this host and loaded into the runner.
    build_plugins "$(cd "$local_path/../.." && pwd)" "$APPS/$key/plugins"
    ;;
  uninstall)
    rm -rf "$APPS/$(app_key "$1")"
    ;;
  run)
    key="$(app_key "$1")"; shift
    mkdir -p "$SOCKETS" "$DATA/$key"
    # The run's output, timestamped, for the run that went wrong; the tool
    # keeps reading the untouched streams.
    log="$DATA/$key/runner.log"
    : > "$log"
    manifest="$APPS/$key/plugins/manifest.json"
    [ -f "$manifest" ] || manifest=""
    # The tool passes its engine switches as one argument; split on spaces.
    # shellcheck disable=SC2068
    exec "$RUNNER" serve \
      --engine-dir "$("$ROOT/tool/engine_dir.sh")" \
      --assets "$APPS/$key/flutter_assets" \
      --icu "$(sdk_icu)" \
      --socket "$SOCKETS/$key.sock" \
      --data-dir "$DATA/$key" \
      ${manifest:+--plugins "$manifest"} \
      -- $@ \
      > >(tee >(stamp >> "$log")) \
      2> >(tee >(stamp >> "$log") >&2)
    ;;
  *)
    echo "usage: raccoon-device ping | install [--instance N] <localPath> <appName> | uninstall [--instance N] <appName> | run [--instance N] <appName> [engine switches]" >&2
    exit 2
    ;;
esac
