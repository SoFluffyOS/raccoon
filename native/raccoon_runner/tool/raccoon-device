#!/usr/bin/env bash
# The commands behind the "raccoon" entry in Flutter's custom_devices.json.
#
#   raccoon-device ping
#   raccoon-device install [--instance KEY] <localPath> <appName>
#   raccoon-device uninstall [--instance KEY] <appName>
#   raccoon-device run [--instance KEY] [--size WxH@R] <appName> [engine switches]
#
# install copies the app bundle the tool built (build/flutter_assets) into the
# runtime's app store; run starts raccoon_runner serve on it and leaves the
# engine's log lines on stdout, where the tool reads the VM service URI, and
# keeps a timestamped copy of the run's output in the app's data directory.
# A runner that ends badly is said so on stderr: its exit code, or the
# signal it died of.
#
# --instance KEY (the "raccoon-KEY" device: 2, phone, tablet, desktop, a name) keeps the same project apart from its
# first run: socket, app store and data directory are named <appName>@N, so
# one project can run at two sizes side by side.
set -euo pipefail

ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
# On Windows this runs in Git Bash (the custom device entry starts it with
# Git's bash.exe), the runner is an .exe, and the paths it is given are
# written C:/..., as the Dart side writes them.
WINDOWS=""
EXE=""
case "$(uname -s)" in MINGW*|MSYS*|CYGWIN*) WINDOWS=1; EXE=.exe ;; esac
native_path() {
  if [ -n "$WINDOWS" ]; then cygpath -m "$1"; else echo "$1"; fi
}
# The binary sits under build/ in a checkout and at the root of a release
# archive (tool/package.sh); RACCOON_RUNNER overrides both.
if [ -n "${RACCOON_RUNNER:-}" ]; then
  RUNNER="$RACCOON_RUNNER"
elif [ -x "$ROOT/build/raccoon_runner$EXE" ]; then
  RUNNER="$ROOT/build/raccoon_runner$EXE"
else
  RUNNER="$ROOT/raccoon_runner$EXE"
fi
APPS="$(native_path "${XDG_DATA_HOME:-$HOME/.local/share}")/raccoon/apps"
# What an app keeps across runs (its shared preferences); install replaces the
# app's bundle but leaves this.
DATA="$(native_path "${XDG_DATA_HOME:-$HOME/.local/share}")/raccoon/data"

# The socket directory must be the one raccoon_runtime's RunnerDiscovery
# watches: the XDG runtime directory on Linux, the user's temporary directory
# on macOS and Windows. The SDK keeps one macOS engine directory for both
# architectures.
case "$(uname -s)" in
  MINGW*|MSYS*|CYGWIN*)
    SOCKETS="$(native_path "${TMP:-/tmp}")/raccoon"
    case "${PROCESSOR_ARCHITEW6432:-${PROCESSOR_ARCHITECTURE:-}}" in
      AMD64) SDK_ENGINE=windows-x64 ;;
      ARM64) SDK_ENGINE=windows-arm64 ;;
      *) echo "unsupported architecture ${PROCESSOR_ARCHITECTURE:-}" >&2; exit 1 ;;
    esac
    ;;
  Darwin)
    TEMP="${TMPDIR:-/tmp}"
    SOCKETS="${TEMP%/}/raccoon"
    SDK_ENGINE=darwin-x64
    ;;
  Linux)
    SOCKETS="${XDG_RUNTIME_DIR:-/tmp}/raccoon"
    case "$(uname -m)" in
      x86_64) SDK_ENGINE=linux-x64 ;;
      aarch64|arm64) SDK_ENGINE=linux-arm64 ;;
      *) echo "unsupported architecture $(uname -m)" >&2; exit 1 ;;
    esac
    ;;
  *) echo "unsupported system $(uname -s)" >&2; exit 1 ;;
esac

# A copy-on-write clone where the file system has one, so an install
# writes no bytes (#115): APFS, btrfs, XFS. A plain copy otherwise.
clone_tree() {
  local flag=""
  case "$(uname -s)" in
    Darwin) flag=-c ;;
    Linux) flag=--reflink=auto ;;
  esac
  if [ -n "$flag" ] && cp "$flag" -R "$1" "$2" 2>/dev/null; then return 0; fi
  rm -rf "$2"
  cp -r "$1" "$2"
}

# The engine revision of the SDK in use, which keys the plugin cache: the
# SDK's stamp, read in place, or tool/engine_dir.sh's answer when there is
# none. Every install needs it; only a run needs the engine itself.
engine_revision() {
  local stamp
  stamp="$(sdk_root 2>/dev/null)/bin/cache/engine.stamp"
  if [ -f "$stamp" ]; then
    tr -d '[:space:]' < "$stamp"
    return 0
  fi
  basename "$(dirname "$("$ROOT/tool/engine_dir.sh")")"
}

sdk_root() {
  if [ -n "${FLUTTER_ROOT:-}" ] && [ -d "$FLUTTER_ROOT/bin/cache" ]; then
    echo "$FLUTTER_ROOT"
  else
    local flutter
    flutter="$(readlink -f "$(command -v flutter)")"
    (cd "$(dirname "$flutter")/.." && pwd)
  fi
}

sdk_icu() {
  native_path "$(sdk_root)/bin/cache/artifacts/engine/$SDK_ENGINE/icudtl.dat"
}

# The package config the app's packages come from: its own, or for a pub
# workspace member the workspace's, kept to what the app reaches
# (tool/package_scope.dart). Prints nothing, and says why, when there is none.
package_config() {
  local project="$1" scoped="$1/build/raccoon/package_config.json"
  if [ -f "$project/.dart_tool/package_config.json" ]; then
    echo "$project/.dart_tool/package_config.json"
    return 0
  fi
  "$(sdk_root)/bin/cache/dart-sdk/bin/dart$EXE" "$(native_path "$ROOT/tool/package_scope.dart")" \
    "$(native_path "$project")" "$(native_path "$scoped")" > /dev/null && echo "$scoped"
}

# On macOS, an application bundle of the app's own around the runner: a
# symlink to it in <key>.app/Contents/MacOS beside an Info.plist, so the
# process has a main bundle and an identifier, dev.raccoon.app.<key>. Some
# plugins' APIs throw without one (UserNotifications, at registration), and
# what they keep by identifier stays the app's (path_provider's directories
# are named after it). For an app with native plugins or native assets.
# Prints the path to run.
app_bundle() {
  local key="$1" bundle id
  bundle="$APPS/$key/$key.app/Contents"
  id="dev.raccoon.app.$(printf '%s' "$key" | tr -c 'A-Za-z0-9.\n' '-')"
  mkdir -p "$bundle/MacOS"
  ln -sfn "$RUNNER" "$bundle/MacOS/raccoon_runner"
  cat > "$bundle/Info.plist" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleIdentifier</key><string>$id</string>
  <key>CFBundleName</key><string>$key</string>
  <key>CFBundleExecutable</key><string>raccoon_runner</string>
  <key>CFBundlePackageType</key><string>APPL</string>
  <key>LSUIElement</key><true/>
</dict>
</plist>
PLIST
  echo "$bundle/MacOS/raccoon_runner"
}

# The key an app's socket, store and data are named by: the app name, with
# @N for an instance other than the first.
# The run's socket: <dir>/<key>.sock, or, when that outgrows what a socket
# path may hold (104 bytes on macOS, whose temp dir alone takes about 50),
# a shorter name, as much of the key as fits and ~<checksum>, with the key
# in a .name file beside it, which discovery reads (#118).
socket_path() {
  local key="$1" path="$SOCKETS/$1.sock" tail room short
  if [ "${#path}" -le 100 ]; then
    echo "$path"
    return 0
  fi
  tail="~$(printf '%s' "$key" | cksum | cut -d' ' -f1)"
  room=$((100 - ${#SOCKETS} - 1 - ${#tail} - 5))
  [ "$room" -lt 0 ] && room=0
  short="${key:0:$room}$tail"
  printf '%s\n' "$key" > "$SOCKETS/$short.name"
  echo "$SOCKETS/$short.sock"
}

app_key() {
  if [ "$INSTANCE" = "1" ]; then echo "$1"; else echo "$1@$INSTANCE"; fi
}

# Prefixes each line with the time of day, to the millisecond.
stamp() {
  perl -pe 'BEGIN { $| = 1 } use Time::HiRes qw(time); my $t = time; my @l = localtime($t);
            $_ = sprintf("%02d:%02d:%06.3f ", $l[2], $l[1], $l[0] + $t - int($t)) . $_'
}

verb="${1:-}"; shift || true
INSTANCE=1
SIZE=""
if [ "${1:-}" = "--instance" ]; then
  INSTANCE="$2"; shift 2
fi
# --size WxH@R: the logical size and pixel ratio a named device starts at
# (the runtime passes it for raccoon-phone, raccoon-tablet, raccoon-desktop).
if [ "${1:-}" = "--size" ]; then
  SIZE="$2"; shift 2
fi


# The window plugins stay the runner's own: their window is the client's pane.
VIRTUAL_PLUGINS="desktop_window window_manager window_size screen_retriever"
# On macOS so does shared_preferences_foundation: the runner keeps each app's
# preferences in its data directory, where NSUserDefaults would share the
# runner's one domain among every app.
VIRTUAL_PLUGINS_MACOS="$VIRTUAL_PLUGINS shared_preferences_foundation"

# The plugin-facing library and its headers: beside the runner in an archive,
# in build/ and third_party/ in a checkout.
plugin_library() {
  local dir
  dir="$(dirname "$RUNNER")"
  [ -f "$dir/libflutter_linux_gtk.so" ] && echo "$dir/libflutter_linux_gtk.so"
}
plugin_headers() {
  if [ -d "$ROOT/include/flutter_linux" ]; then
    echo "$ROOT/include"
  elif [ -d "$ROOT/third_party/flutter_linux/flutter/shell/platform/linux/public/flutter_linux" ]; then
    echo "$ROOT/third_party/flutter_linux/flutter/shell/platform/linux/public"
  fi
}

# Builds a project's native plugins into |out| and writes |out|/manifest.json
# for the runner's --plugins: the Linux half, the macOS half or the Windows
# half below. When there is nothing it can do, says why and leaves no
# manifest; the app then sees no plugin.
build_plugins() {
  local project="$1" out="$2" config
  rm -rf "$out"
  config="$(package_config "$project")"
  [ -n "$config" ] || return 0
  if [ -n "$WINDOWS" ]; then
    build_plugins_windows "$project" "$out" "$config"
    return 0
  fi
  command -v python3 >/dev/null || { echo "🦝 no python3; native plugins skipped" >&2; return 0; }
  case "$(uname -s)" in
    Darwin) build_plugins_macos "$project" "$out" "$config" ;;
    *) build_plugins_linux "$project" "$out" "$config" ;;
  esac
}

# The Windows half, tool/plugins_windows.dart, run with the SDK's own dart:
# Windows has no python3. It builds against the SDK's import library and
# C++ client wrapper, and the runner loads the plugins on the
# flutter_windows.dll beside it, so a runner without one gets none.
build_plugins_windows() {
  local project="$1" out="$2" config="$3" engine version cache sdk
  if [ ! -f "$(dirname "$RUNNER")/flutter_windows.dll" ]; then
    echo "🦝 this runner has no flutter_windows.dll; native plugins skipped" >&2
    return 0
  fi
  engine="$(engine_revision)"
  version="$(tr -d '[:space:]' < "$ROOT/VERSION")"
  cache="${RACCOON_PLUGIN_CACHE:-${XDG_CACHE_HOME:-$HOME/.cache}/raccoon/plugins/$engine}"
  sdk="$(sdk_root)"
  "$sdk/bin/cache/dart-sdk/bin/dart.exe" "$(native_path "$ROOT/tool/plugins_windows.dart")" \
    "$(native_path "$config")" "$(native_path "$out")" \
    "$VIRTUAL_PLUGINS" "$(native_path "$cache")" "$version" \
    "$(native_path "$sdk/bin/cache/artifacts/engine/$SDK_ENGINE")"
}

# The Linux half: the resolved packages (.dart_tool/package_config.json)
# whose pubspec names a Linux pluginClass (registered) or ffiPlugin (its
# libraries only), as the Flutter tool finds them. What built before is in a
# cache by plugin version, runner version and engine; what the release
# prebuilt comes from its archive, fetched once; the rest builds here, each
# plugin in its own CMake project with what the desktop template gives a
# plugin, so one that fails sinks nothing else. Every library lands flat in
# |out|/lib, which run puts on the runner's library path for the FFI ones. A
# machine without a toolchain still gets the cached and prebuilt ones.
build_plugins_linux() {
  local project="$1" out="$2" config="$3" lib headers engine version cache
  lib="$(plugin_library || true)"
  headers="$(plugin_headers || true)"
  if [ -z "$lib" ] || [ -z "$headers" ]; then
    echo "🦝 this runner has no plugin library; native plugins skipped" >&2
    return 0
  fi
  engine="$(engine_revision)"
  version="$(tr -d '[:space:]' < "$ROOT/VERSION")"
  cache="${RACCOON_PLUGIN_CACHE:-${XDG_CACHE_HOME:-$HOME/.cache}/raccoon/plugins/$engine}"
  python3 - "$config" "$out" "$lib" "$headers" "$VIRTUAL_PLUGINS" \
    "$cache" "$version" "$(uname -m)" \
    "${RACCOON_PREBUILT_PLUGINS:-https://github.com/SoFluffyOS/raccoon/releases/download/runner-v$version/plugins-$engine-linux-$(uname -m).tar.gz}" <<'PY'
import glob, hashlib, json, os, re, shutil, subprocess, sys, tarfile, time
started = time.time()
from urllib.parse import unquote, urlparse

def clone(source, target):
    # A copy-on-write clone where the file system has one, so an install
    # writes no bytes (#115); a plain copy otherwise.
    flag = {'darwin': '-c', 'linux': '--reflink=auto'}.get(sys.platform)
    if flag and subprocess.run(['cp', flag, '-R', source, target],
                               stderr=subprocess.DEVNULL).returncode == 0:
        return
    if os.path.isdir(source) and not os.path.islink(source):
        shutil.rmtree(target, ignore_errors=True)
        shutil.copytree(source, target, symlinks=True)
    else:
        shutil.copy2(source, target)

config, out, lib, headers, virtual, cache, runner_version, arch, prebuilt_url = sys.argv[1:10]
virtual = set(virtual.split())
dart_tool = os.path.dirname(os.path.abspath(config))

PREAMBLE = """cmake_minimum_required(VERSION 3.14)
project(raccoon_plugin LANGUAGES CXX)
set(CMAKE_BUILD_TYPE Release)
function(APPLY_STANDARD_SETTINGS TARGET)
  target_compile_features(${TARGET} PUBLIC cxx_std_14)
  target_compile_options(${TARGET} PRIVATE -Wall -Werror)
  target_compile_options(${TARGET} PRIVATE "$<$<NOT:$<CONFIG:Debug>>:-O3>")
  target_compile_definitions(${TARGET} PRIVATE "$<$<NOT:$<CONFIG:Debug>>:NDEBUG>")
endfunction()
find_package(PkgConfig REQUIRED)
pkg_check_modules(GTK REQUIRED IMPORTED_TARGET gtk+-3.0)
pkg_check_modules(GLIB REQUIRED IMPORTED_TARGET glib-2.0)
pkg_check_modules(GIO REQUIRED IMPORTED_TARGET gio-2.0)
add_library(flutter INTERFACE)
target_include_directories(flutter INTERFACE "%s")
target_link_libraries(flutter INTERFACE "%s" PkgConfig::GTK PkgConfig::GLIB PkgConfig::GIO)
""" % (headers, lib)


def linux_block(pubspec):
    found = re.search(r'^([ \t]*)linux:[ \t]*\n', pubspec, re.M)
    if not found:
        return ''
    indent = len(found.group(1))
    block = []
    for line in pubspec[found.end():].splitlines():
        if not line.strip():
            continue
        if len(line) - len(line.lstrip()) <= indent:
            break
        block.append(line)
    return '\n'.join(block)


def version_key(name, root):
    # A hosted package is its directory name, name-version. A git one is its
    # place in the cache, which names the commit. A path package is the shape
    # of its native side, so an edit rebuilds it: every file but its Dart
    # code, tests, examples, build output and hidden folders, so the shared
    # sources an FFI plugin builds (src/) count too (#121).
    real = os.path.realpath(root)
    cache_marker = os.sep + '.pub-cache' + os.sep
    if cache_marker + 'hosted' + os.sep in real + os.sep:
        return os.path.basename(real.rstrip(os.sep))
    if cache_marker in real + os.sep:
        place = real.split(cache_marker, 1)[1]
        return '%s-git-%s' % (name, hashlib.sha256(place.encode('utf-8', 'surrogateescape')).hexdigest()[:16])
    digest = hashlib.sha256()
    for dirpath, dirs, files in os.walk(root):
        top = dirpath == root
        dirs[:] = sorted(d for d in dirs if not d.startswith('.')
                         and not (top and d in ('lib', 'test', 'example', 'build'))
                         and not os.path.isfile(os.path.join(dirpath, d, 'pubspec.yaml')))
        for f in sorted(files):
            full = os.path.join(dirpath, f)
            try:
                st = os.lstat(full)
            except OSError:
                continue
            digest.update(('%s %d %d\n' % (os.path.relpath(full, root), st.st_size, int(st.st_mtime))).encode('utf-8', 'surrogateescape'))
    return '%s-path-%s' % (name, digest.hexdigest()[:16])


# The runner's version is part of the key: the library's ABI is the vendored
# sources, which change with it. The same key names what the release
# prebuilt, so its archive drops straight into the cache.
lib_stamp = runner_version


def fetch_prebuilt():
    """The release's prebuilt plugins into the cache, once per runner version
    and engine; a marker remembers a miss so it is not asked again."""
    if os.environ.get('RACCOON_NO_PREBUILT'):
        return
    marker = os.path.join(cache, 'prebuilt-%s.%s' % (runner_version, 'done'))
    if os.path.exists(marker):
        return
    os.makedirs(cache, exist_ok=True)
    # Unpacked aside, then moved in entry by entry: an interrupted fetch
    # leaves no half entry that would count as cached (#122).
    import tempfile
    staging = tempfile.mkdtemp(prefix='.prebuilt-', dir=cache)
    archive = os.path.join(staging, 'archive.tar.gz')
    remember = True
    try:
        # Only when downloading: importing it costs every install 20 ms.
        import urllib.error, urllib.request
        urllib.request.urlretrieve(prebuilt_url, archive)
        with tarfile.open(archive) as tar:
            members = [m for m in tar.getmembers()
                       if m.isfile() and m.name.endswith('.so') and '..' not in m.name]
            tar.extractall(staging, members=members)
        os.remove(archive)
        for entry in os.listdir(staging):
            if not os.path.exists(os.path.join(cache, entry)):
                os.replace(os.path.join(staging, entry), os.path.join(cache, entry))
        print('🦝 prebuilt plugins fetched for runner %s' % runner_version, file=sys.stderr)
    except Exception as error:
        # No archive for this version is worth remembering; a network
        # failure or a server error is not, so the next install asks again.
        if isinstance(error, urllib.error.HTTPError):
            remember = error.code == 404
        elif isinstance(error, urllib.error.URLError):
            remember = False
    finally:
        shutil.rmtree(staging, ignore_errors=True)
    if remember:
        open(marker, 'w').close()


def can_build():
    for need in ('cmake', 'ninja', 'pkg-config'):
        if shutil.which(need) is None:
            return 'no ' + need
    if subprocess.run(['pkg-config', '--exists', 'gtk+-3.0']).returncode != 0:
        return 'no gtk+-3.0 development files'
    return None

wanted = []
status = []  # what never gets as far as a library, for the runner to relay
packages = []
for package in json.load(open(config)).get('packages', []):
    uri = package.get('rootUri', '')
    root = unquote(urlparse(uri).path) if uri.startswith('file://') else os.path.normpath(os.path.join(dart_tool, unquote(uri)))
    pubspec_path = os.path.join(root, 'pubspec.yaml')
    if os.path.isfile(pubspec_path):
        packages.append((package['name'], root, open(pubspec_path).read()))
# Implementation packages of federated plugins: named as a default_package
# by their app-facing package, or saying what they implement. Not the ones
# to blame for a missing host.
implementations = set()
for _, _, pubspec in packages:
    implementations.update(re.findall(r'default_package:\s*(\w+)', pubspec))
for name, root, pubspec in packages:
    if name in virtual:
        status.append({'name': name, 'state': 'built_in', 'detail': 'the runner answers it'})
        continue
    found = re.search(r'^\s+plugin:\s*$', pubspec, re.M)
    if not found:
        continue
    # Only what flutter: plugin: says: pub.dev's top-level platforms: list
    # names hosts too, with nothing under them (#92).
    plugin = pubspec[found.end():]
    block = linux_block(plugin)
    cls = re.search(r'pluginClass:\s*(\w+)', block)
    ffi = re.search(r'ffiPlugin:\s*true', block) is not None
    if cls is None and not ffi:
        # An app-facing plugin with no Linux at all (its platforms name
        # others; an implementation package says what it implements and is
        # not the one to blame): the app's calls to it will fail, and the
        # pane can say so before they do.
        if (not block and re.search(r'^\s+platforms:\s*$', plugin, re.M)
                and not re.search(r'^\s+linux:', plugin, re.M)
                and not re.search(r'^\s+implements:', pubspec, re.M)
                and name not in implementations):
            status.append({'name': name, 'state': 'no_host', 'detail': 'no Linux implementation'})
        continue
    if not os.path.isfile(os.path.join(root, 'linux', 'CMakeLists.txt')):
        continue
    symbol = None
    if cls is not None:
        symbol = re.sub(r'(?<!^)(?=[A-Z])', '_', cls.group(1)).lower() + '_register_with_registrar'
    wanted.append({'name': name, 'root': root, 'symbol': symbol,
                   'key': '%s-%s-%s' % (version_key(name, root), lib_stamp, arch)})

if not wanted and not status:
    sys.exit(0)

os.makedirs(os.path.join(out, 'lib'), exist_ok=True)
built, failed, empty, from_cache = [], [], [], []
entries = []
toolchain = None  # looked up when a build is needed
for plugin in wanted:
    name = plugin['name']
    cached = os.path.join(cache, plugin['key'])
    libs = sorted(glob.glob(os.path.join(cached, '*.so')))
    if not libs:
        fetch_prebuilt()
        libs = sorted(glob.glob(os.path.join(cached, '*.so')))
    if libs:
        from_cache.append(name)
    else:
        if toolchain is None:
            toolchain = can_build() or 'ok'
        if toolchain != 'ok':
            failed.append('%s (%s)' % (name, toolchain))
            status.append({'name': name, 'state': 'failed', 'detail': toolchain + '; native plugins need the desktop toolchain'})
            continue
        project = os.path.join(out, 'build', name)
        os.makedirs(project, exist_ok=True)
        with open(os.path.join(project, 'CMakeLists.txt'), 'w') as f:
            f.write(PREAMBLE)
            f.write('add_subdirectory("%s" "plugin")\n' % os.path.join(plugin['root'], 'linux'))
        with open(os.path.join(project, 'build.log'), 'w') as log:
            ok = subprocess.run(['cmake', '-S', project, '-B', os.path.join(project, 'out'), '-G', 'Ninja'],
                                stdout=log, stderr=subprocess.STDOUT).returncode == 0
            ok = ok and subprocess.run(['cmake', '--build', os.path.join(project, 'out')],
                                       stdout=log, stderr=subprocess.STDOUT).returncode == 0
        libs = sorted(glob.glob(os.path.join(project, 'out', 'plugin', '**', '*.so'), recursive=True)) if ok else []
        if not ok:
            failed.append('%s (see %s)' % (name, os.path.join(project, 'build.log')))
            status.append({'name': name, 'state': 'failed', 'detail': 'did not build; see ' + os.path.join(project, 'build.log')})
            continue
        if not libs:
            # Built fine and made nothing: an FFI plugin whose library wants
            # a toolchain this machine has not (jni without a JDK).
            empty.append(name)
            status.append({'name': name, 'state': 'built_nothing', 'detail': 'built and made no library'})
            continue
        # Copied aside, then renamed into place: an interrupted copy leaves
        # no entry that counts as cached (#122).
        staging = cached + '.partial'
        shutil.rmtree(staging, ignore_errors=True)
        os.makedirs(staging)
        for so in libs:
            shutil.copy2(so, staging)
        shutil.rmtree(cached, ignore_errors=True)
        os.replace(staging, cached)
        libs = sorted(glob.glob(os.path.join(cached, '*.so')))
        built.append(name)
    for so in libs:
        clone(so, os.path.join(out, 'lib'))
    if plugin['symbol'] is not None:
        # The plugin's own library is the one named after it.
        main = [so for so in libs if os.path.basename(so) == 'lib%s_plugin.so' % name] or libs
        entries.append({'name': name, 'library': os.path.join(out, 'lib', os.path.basename(main[0])),
                        'symbol': plugin['symbol']})

json.dump({'plugins': entries, 'status': status, 'library_path': os.path.join(out, 'lib')},
          open(os.path.join(out, 'manifest.json'), 'w'), indent=1)
parts = []
if built:
    parts.append('%d built: %s' % (len(built), ', '.join(built)))
if from_cache:
    parts.append('%d from the cache: %s' % (len(from_cache), ', '.join(from_cache)))
if empty:
    parts.append('%d built nothing: %s' % (len(empty), ', '.join(empty)))
if failed:
    parts.append('%d failed: %s' % (len(failed), '; '.join(failed)))
if not parts:
    parts.append('none to build')
print('🦝 native plugins ready in %.1f s: ' % (time.time() - started) + '; '.join(parts), file=sys.stderr)
PY
}

# The macOS half: the resolved packages whose pubspec names a macOS
# pluginClass (registered) or ffiPlugin (opened only, for Dart to find),
# their pods built against the SDK's FlutterMacOS.framework.
# One CocoaPods project for what the cache misses (never integrated into a
# target, so it needs no Xcode project of the app's or its own), then
# each plugin's pod target on its own, so one that fails sinks nothing else;
# its framework and those of the pods it depends on are cached by plugin
# version, runner version, engine and architecture, and what the release
# prebuilt comes from its archive, fetched once. Every framework lands
# flat in |out|/frameworks, where they find each other by @loader_path; the
# manifest names the SDK's FlutterMacOS for the runner to open first.
build_plugins_macos() {
  local project="$1" out="$2" config="$3" sdk engine version cache
  sdk="$(sdk_root)"
  engine="$(engine_revision)"
  version="$(tr -d '[:space:]' < "$ROOT/VERSION")"
  cache="${RACCOON_PLUGIN_CACHE:-${XDG_CACHE_HOME:-$HOME/.cache}/raccoon/plugins/$engine}"
  python3 - "$config" "$out" "$VIRTUAL_PLUGINS_MACOS" \
    "$cache" "$version" "$(uname -m)" "$sdk/bin/cache/artifacts/engine/darwin-x64" \
    "${RACCOON_PREBUILT_PLUGINS:-https://github.com/SoFluffyOS/raccoon/releases/download/runner-v$version/plugins-$engine-macos-$(uname -m).tar.gz}" \
    "$project" <<'PY'
import hashlib, json, os, re, shutil, subprocess, sys, tarfile, time
started = time.time()
from urllib.parse import unquote, urlparse

def clone(source, target):
    # A copy-on-write clone where the file system has one, so an install
    # writes no bytes (#115); a plain copy otherwise.
    flag = {'darwin': '-c', 'linux': '--reflink=auto'}.get(sys.platform)
    if flag and subprocess.run(['cp', flag, '-R', source, target],
                               stderr=subprocess.DEVNULL).returncode == 0:
        return
    if os.path.isdir(source) and not os.path.islink(source):
        shutil.rmtree(target, ignore_errors=True)
        shutil.copytree(source, target, symlinks=True)
    else:
        shutil.copy2(source, target)

config, out, virtual, cache, runner_version, arch, engine_dir, prebuilt_url, project = sys.argv[1:10]
virtual = set(virtual.split())
dart_tool = os.path.dirname(os.path.abspath(config))
# What flutter precache --macos ships: the xcframework, no podspec (one in
# an SDK's cache is a leftover of older flows, as is a bare framework).
xcframework = os.path.join(engine_dir, 'FlutterMacOS.xcframework')
flutter_framework = os.path.join(xcframework, 'macos-arm64_x86_64', 'FlutterMacOS.framework', 'FlutterMacOS')
env = dict(os.environ, LANG='en_US.UTF-8', LC_ALL='en_US.UTF-8')


def platform_block(pubspec, platform):
    found = re.search(r'^([ \t]*)%s:[ \t]*\n' % platform, pubspec, re.M)
    if not found:
        return ''
    indent = len(found.group(1))
    block = []
    for line in pubspec[found.end():].splitlines():
        if not line.strip():
            continue
        if len(line) - len(line.lstrip()) <= indent:
            break
        block.append(line)
    return '\n'.join(block)


def version_key(name, root, sources):
    # A hosted package is its directory name, name-version. A git one is its
    # place in the cache, which names the commit. A path package is the shape
    # of its native side, so an edit rebuilds it: every file but its Dart
    # code, tests, examples, build output and hidden folders, so the shared
    # sources an FFI plugin builds (src/) count too (#121).
    real = os.path.realpath(root)
    cache_marker = os.sep + '.pub-cache' + os.sep
    if cache_marker + 'hosted' + os.sep in real + os.sep:
        return os.path.basename(real.rstrip(os.sep))
    if cache_marker in real + os.sep:
        place = real.split(cache_marker, 1)[1]
        return '%s-git-%s' % (name, hashlib.sha256(place.encode('utf-8', 'surrogateescape')).hexdigest()[:16])
    digest = hashlib.sha256()
    for dirpath, dirs, files in os.walk(root):
        top = dirpath == root
        dirs[:] = sorted(d for d in dirs if not d.startswith('.')
                         and not (top and d in ('lib', 'test', 'example', 'build'))
                         and not os.path.isfile(os.path.join(dirpath, d, 'pubspec.yaml')))
        for f in sorted(files):
            full = os.path.join(dirpath, f)
            try:
                st = os.lstat(full)
            except OSError:
                continue
            digest.update(('%s %d %d\n' % (os.path.relpath(full, root), st.st_size, int(st.st_mtime))).encode('utf-8', 'surrogateescape'))
    return '%s-path-%s' % (name, digest.hexdigest()[:16])


def can_build():
    if shutil.which('pod') is None:
        return 'no CocoaPods (pod)'
    if subprocess.run(['xcodebuild', '-version'], stdout=subprocess.DEVNULL,
                      stderr=subprocess.DEVNULL).returncode != 0:
        return 'no Xcode (xcodebuild)'
    if not os.path.isfile(flutter_framework):
        return 'no FlutterMacOS in the SDK (flutter precache --macos)'
    return None


def dependencies(pubspec):
    found = re.search(r'^dependencies:[ \t]*\n', pubspec, re.M)
    if not found:
        return set()
    names = set()
    for line in pubspec[found.end():].splitlines():
        if not line.strip() or line.lstrip().startswith('#'):
            continue
        if not line.startswith((' ', '\t')):
            break
        named = re.match(r'^  (\w+):', line)
        if named:
            names.add(named.group(1))
    return names


def fetch_prebuilt():
    """The release's prebuilt plugins into the cache, once per runner version
    and engine; a marker remembers a miss so it is not asked again."""
    if os.environ.get('RACCOON_NO_PREBUILT'):
        return
    marker = os.path.join(cache, 'prebuilt-%s-macos.done' % runner_version)
    if os.path.exists(marker):
        return
    os.makedirs(cache, exist_ok=True)
    # Unpacked aside, then moved in entry by entry: an interrupted fetch
    # leaves no half entry that would count as cached (#122).
    import tempfile
    staging = tempfile.mkdtemp(prefix='.prebuilt-', dir=cache)
    archive = os.path.join(staging, 'archive.tar.gz')
    remember = True
    try:
        # Only when downloading: importing it costs every install 20 ms.
        import urllib.error, urllib.request
        urllib.request.urlretrieve(prebuilt_url, archive)
        with tarfile.open(archive) as tar:
            # Frameworks, with their symlinks; nothing that would land or
            # point outside the cache.
            if hasattr(tarfile, 'data_filter'):
                tar.extractall(staging, filter='data')
            else:
                members = [m for m in tar.getmembers()
                           if not m.name.startswith('/') and '..' not in m.name.split('/')
                           and not (m.issym() and (m.linkname.startswith('/') or '..' in m.linkname.split('/')[:-1]))]
                tar.extractall(staging, members=members)
        os.remove(archive)
        for entry in os.listdir(staging):
            if not os.path.exists(os.path.join(cache, entry)):
                os.replace(os.path.join(staging, entry), os.path.join(cache, entry))
        print('🦝 prebuilt plugins fetched for runner %s' % runner_version, file=sys.stderr)
    except Exception as error:
        # No archive for this version is worth remembering; a network
        # failure or a server error is not, so the next install asks again.
        if isinstance(error, urllib.error.HTTPError):
            remember = error.code == 404
        elif isinstance(error, urllib.error.URLError):
            remember = False
    finally:
        shutil.rmtree(staging, ignore_errors=True)
    if remember:
        open(marker, 'w').close()


def frameworks(directory):
    return sorted(f for f in os.listdir(directory)
                  if f.endswith('.framework') and not f.startswith('._')) if os.path.isdir(directory) else []


def binaries(directory):
    """The frameworks and libraries in a cache entry or the install."""
    return sorted(f for f in os.listdir(directory)
                  if f.endswith(('.framework', '.dylib')) and not f.startswith('._')) if os.path.isdir(directory) else []


def binary_of(path):
    """The Mach-O file of a framework, or the library itself."""
    if path.endswith('.dylib'):
        return path
    return os.path.join(path, os.path.basename(path)[:-len('.framework')])


def rpath_needs(binary):
    """The frameworks and libraries [binary] loads by @rpath, by name."""
    listing = subprocess.run(['otool', '-L', binary], capture_output=True, text=True).stdout
    return re.findall(r'@rpath/([^/\s]+\.(?:framework|dylib))', listing)


def vendored(made, roots):
    """What the built frameworks load by @rpath that the build left where a
    pod vendors it, as an app's embed step would copy it: plain frameworks
    (ffmpegkit) and libraries (libisar.dylib), and what they load in turn
    (#93). Looked for under [roots]: the plugin's sources, the pods."""
    present = {os.path.basename(path) for path in made} | {'FlutterMacOS.framework'}
    queue = [binary_of(path) for path in made]
    found = []
    while queue:
        for need in rpath_needs(queue.pop()):
            if need in present:
                continue
            present.add(need)
            path = next((os.path.join(top, need)
                         for root in roots if os.path.isdir(root)
                         for top, dirs, files in os.walk(root, followlinks=True)
                         if need in dirs or need in files), None)
            if path is None:
                continue
            found.append(path)
            queue.append(binary_of(path))
    return found


def in_cache(plugin):
    """Whether the cache holds the plugin, every framework and library its
    frameworks load by @rpath included: helpers before #84 and #93 left out
    the vendored ones, so such an entry is built again. Checked once, then
    stamped."""
    entry = os.path.join(cache, plugin['key'])
    present = binaries(entry)
    if not any(f.endswith('.framework') for f in present):
        return False
    stamp = os.path.join(entry, '.complete')
    if os.path.exists(stamp):
        return True
    loadable = set(present) | {'FlutterMacOS.framework'}
    for f in present:
        if any(dep not in loadable for dep in rpath_needs(binary_of(os.path.join(entry, f)))):
            return False
    open(stamp, 'w').close()
    return True


wanted = []
status = []  # what never gets as far as a library, for the runner to relay
packages = []
for package in json.load(open(config)).get('packages', []):
    uri = package.get('rootUri', '')
    root = unquote(urlparse(uri).path) if uri.startswith('file://') else os.path.normpath(os.path.join(dart_tool, unquote(uri)))
    pubspec_path = os.path.join(root, 'pubspec.yaml')
    if os.path.isfile(pubspec_path):
        packages.append((package['name'], root, open(pubspec_path).read()))
# Implementation packages of federated plugins, not the ones to blame for
# a missing host (as on Linux).
implementations = set()
for _, _, pubspec in packages:
    implementations.update(re.findall(r'default_package:\s*(\w+)', pubspec))
implementations.update(name for name, _, pubspec in packages
                       if re.search(r'^\s+implements:', pubspec, re.M))
# What the app reaches without going through another host's implementation:
# jni, say, comes only with path_provider_android and is not the app's to
# miss on macOS.
by_name = {name: pubspec for name, _, pubspec in packages}
app = next((name for name, root, _ in packages if os.path.normpath(root) == os.path.normpath(project)), None)
reached, pending = set(), [app] if app else []
while pending:
    current = pending.pop()
    if current in reached or current not in by_name:
        continue
    reached.add(current)
    if current != app and current in implementations:
        continue
    pending.extend(dependencies(by_name[current]))
for name, root, pubspec in packages:
    if name in virtual:
        status.append({'name': name, 'state': 'built_in', 'detail': 'the runner answers it'})
        continue
    found = re.search(r'^\s+plugin:\s*$', pubspec, re.M)
    if not found:
        continue
    # Only what flutter: plugin: says: pub.dev's top-level platforms: list
    # names hosts too, with nothing under them (#92).
    plugin = pubspec[found.end():]
    block = platform_block(plugin, 'macos')
    cls = re.search(r'pluginClass:\s*(\w+)', block)
    ffi = re.search(r'ffiPlugin:\s*true', block) is not None
    if cls is None and not ffi:
        if (not block and re.search(r'^\s+platforms:\s*$', plugin, re.M)
                and not re.search(r'^\s+macos:', plugin, re.M)
                and name not in implementations
                and (app is None or name in reached)):
            status.append({'name': name, 'state': 'no_host', 'detail': 'no macOS implementation'})
        continue
    sources = os.path.join(root, 'darwin' if re.search(r'sharedDarwinSource:\s*true', block) else 'macos')
    if not os.path.isfile(os.path.join(sources, name + '.podspec')):
        continue
    # An FFI plugin has no class: its framework is opened for Dart to find.
    wanted.append({'name': name, 'root': root, 'sources': sources,
                   'class': cls.group(1) if cls else None,
                   'key': '%s-%s-%s' % (version_key(name, root, sources), runner_version, arch)})

if not wanted and not status:
    sys.exit(0)

os.makedirs(os.path.join(out, 'frameworks'), exist_ok=True)
built, failed, empty, from_cache = [], [], [], []
misses = [p for p in wanted if not in_cache(p)]
if misses:
    fetch_prebuilt()
    misses = [p for p in wanted if not in_cache(p)]
broken = {}  # name: why, for the misses that did not build
if misses:
    toolchain = can_build()
    pods = os.path.join(out, 'build')
    log_path = os.path.join(pods, 'pod-install.log')
    if toolchain is None:
        os.makedirs(pods, exist_ok=True)
        # FlutterMacOS as a pod of our own, vending the SDK's xcframework.
        flutter_pod = os.path.join(pods, 'FlutterMacOS')
        os.makedirs(flutter_pod, exist_ok=True)
        if not os.path.lexists(os.path.join(flutter_pod, 'FlutterMacOS.xcframework')):
            os.symlink(xcframework, os.path.join(flutter_pod, 'FlutterMacOS.xcframework'))
        with open(os.path.join(flutter_pod, 'FlutterMacOS.podspec'), 'w') as f:
            f.write("Pod::Spec.new do |s|\n"
                    "  s.name = 'FlutterMacOS'\n"
                    "  s.version = '1.0.0'\n"
                    "  s.summary = 'FlutterMacOS from the Flutter SDK, for plugins to link.'\n"
                    "  s.homepage = 'https://flutter.dev'\n"
                    "  s.license = { :type => 'BSD' }\n"
                    "  s.author = 'Flutter'\n"
                    "  s.source = { :path => '.' }\n"
                    "  s.osx.deployment_target = '10.15'\n"
                    "  s.vendored_frameworks = 'FlutterMacOS.xcframework'\n"
                    "end\n")
        # Every package by its bare name, as Flutter's own macOS build lays
        # them out: podspecs find their siblings that way (FlutterFire's read
        # the SDK version from ../../firebase_core).
        links = os.path.join(pods, '.symlinks', 'plugins')
        os.makedirs(links, exist_ok=True)
        for name, root, _ in packages:
            link = os.path.join(links, name)
            if not os.path.lexists(link):
                os.symlink(root, link)
        # The deployment target of this machine: the frameworks run nowhere
        # else, and no pod asks for more.
        macos = subprocess.run(['sw_vers', '-productVersion'], capture_output=True, text=True).stdout.strip()
        # Every plugin's pod, the cached ones too, so a pod that depends on
        # one (firebase_analytics on firebase_core) resolves; only the misses
        # are built. A miss CocoaPods names in what stops it is dropped, its
        # log kept, and the rest are installed again without it (#82).
        podded = list(wanted)
        miss_names = {p['name'] for p in misses}
        while True:
            with open(os.path.join(pods, 'Podfile'), 'w') as f:
                f.write("platform :osx, '%s.0'\n" % (macos.split('.')[0] or '11'))
                f.write("install! 'cocoapods', :integrate_targets => false, :warn_for_unused_master_specs_repo => false\n")
                # Every pod a dynamic framework, static_framework or not
                # (FlutterFire's are): the runner opens them, nothing links them.
                f.write("pre_install do |installer|\n"
                        "  installer.pod_targets.each do |target|\n"
                        "    def target.build_type\n"
                        "      Pod::BuildType.dynamic_framework\n"
                        "    end\n"
                        "  end\n"
                        "end\n")
                # A pod's own minimum goes, so it builds for this machine as
                # the platform above says; Flutter's podhelper drops it too
                # when it asks for less than the app (#83).
                # And every pod links every framework its dependencies build,
                # not only its own pods': a ready-made static library inside
                # it (GoogleAppMeasurement) needs symbols from pods it never
                # names (#84).
                f.write("post_install do |installer|\n"
                        "  installer.pods_project.targets.each do |target|\n"
                        "    target.build_configurations.each do |config|\n"
                        "      config.build_settings.delete 'MACOSX_DEPLOYMENT_TARGET'\n"
                        "    end\n"
                        "  end\n"
                        "  installer.pod_targets.each do |pod|\n"
                        "    needed = pod.recursive_dependent_targets.select(&:should_build?).map(&:product_module_name).uniq\n"
                        "    native = installer.pods_project.targets.find { |t| t.name == pod.label }\n"
                        "    next if needed.empty? || native.nil?\n"
                        "    native.build_configurations.each do |config|\n"
                        "      config.build_settings['OTHER_LDFLAGS'] = ['$(inherited)'] + needed.flat_map { |n| ['-framework', n] }\n"
                        "    end\n"
                        "  end\n"
                        "end\n")
                # Never integrated, so no Xcode project is read: the target is
                # a name, and Swift 5 is what Flutter's Runner target would
                # give the pods that name no Swift version.
                f.write("use_frameworks!\ntarget 'Host' do\n"
                        "  current_target_definition.swift_version = '5.0'\n")
                f.write("  pod 'FlutterMacOS', :path => 'FlutterMacOS'\n")
                for plugin in podded:
                    linked = os.path.join('.symlinks', 'plugins', plugin['name'], os.path.basename(plugin['sources']))
                    f.write("  pod %s, :path => %s\n" % (json.dumps(plugin['name']), json.dumps(linked)))
                f.write("end\n")
            with open(log_path, 'w') as log:
                installed = subprocess.run(['pod', 'install'], cwd=pods, env=env,
                                           stdout=log, stderr=subprocess.STDOUT).returncode == 0
            if installed:
                break
            errors = ' '.join(line for line in open(log_path, errors='replace') if line.startswith('[!]'))
            culprits = miss_names & set(re.findall(r'`([\w-]+)`', errors)) & {p['name'] for p in podded}
            if not culprits:
                toolchain = 'pod install failed; see ' + log_path
                break
            for name in sorted(culprits):
                kept = os.path.join(pods, 'pod-install-%s.log' % name)
                shutil.copyfile(log_path, kept)
                broken[name] = 'pod install failed; see ' + kept
            podded = [p for p in podded if p['name'] not in culprits]
    for plugin in misses:
        name = plugin['name']
        if name in broken:
            continue
        if toolchain is not None:
            broken[name] = toolchain
            continue
        symroot = os.path.join(pods, 'out', name)
        build_log = os.path.join(pods, name + '.log')
        with open(build_log, 'w') as log:
            ok = subprocess.run(
                ['xcodebuild', '-project', os.path.join(pods, 'Pods', 'Pods.xcodeproj'),
                 '-target', name, '-configuration', 'Release',
                 'ARCHS=' + arch, 'ONLY_ACTIVE_ARCH=YES',
                 'SYMROOT=' + symroot, 'OBJROOT=' + os.path.join(pods, 'obj', name),
                 'LD_RUNPATH_SEARCH_PATHS=@loader_path/../../..',
                 'CODE_SIGNING_ALLOWED=NO', 'build'],
                env=env, stdout=log, stderr=subprocess.STDOUT).returncode == 0
        if not ok:
            broken[name] = 'did not build; see ' + build_log
            continue
        cached = os.path.join(cache, plugin['key'])
        release = os.path.join(symroot, 'Release')
        made = [(d, f) for d in sorted(os.listdir(release))
                if d not in ('FlutterMacOS', 'XCFrameworkIntermediates')
                for f in frameworks(os.path.join(release, d))] if os.path.isdir(release) else []
        # Ready-made dynamic frameworks the pods bring (Agora's), which
        # CocoaPods leaves under XCFrameworkIntermediates/<pod>/<variant>;
        # not FlutterMacOS, and not the static ones, linked in already (#84).
        intermediates = os.path.join(release, 'XCFrameworkIntermediates')
        for pod in sorted(os.listdir(intermediates)) if os.path.isdir(intermediates) else []:
            if pod == 'FlutterMacOS':
                continue
            for variant, _, _ in os.walk(os.path.join(intermediates, pod)):
                for f in frameworks(variant):
                    binary = os.path.join(variant, f, f[:-len('.framework')])
                    kind = subprocess.run(['file', '-bL', binary], capture_output=True, text=True).stdout
                    if 'dynamically linked shared library' in kind:
                        made.append((os.path.relpath(variant, release), f))
        if not any(f == name + '.framework' for _, f in made):
            empty.append(name)
            status.append({'name': name, 'state': 'built_nothing', 'detail': 'built and made no framework'})
            broken[name] = None
            continue
        # A fresh entry: one built again replaces what an older helper left.
        # Copied aside, then renamed into place: an interrupted copy leaves
        # no entry that counts as cached (#122).
        staging = cached + '.partial'
        shutil.rmtree(staging, ignore_errors=True)
        os.makedirs(staging)
        for d, f in made:
            shutil.copytree(os.path.join(release, d, f), os.path.join(staging, f), symlinks=True,
                            dirs_exist_ok=True)
        for path in vendored([os.path.join(release, d, f) for d, f in made],
                             [plugin['sources'], os.path.join(pods, 'Pods')]):
            target = os.path.join(staging, os.path.basename(path))
            if os.path.isdir(path):
                shutil.copytree(path, target, symlinks=True, dirs_exist_ok=True)
            else:
                shutil.copy2(path, target)
        shutil.rmtree(cached, ignore_errors=True)
        os.replace(staging, cached)
        built.append(name)

entries = []
for plugin in wanted:
    name = plugin['name']
    if name in broken:
        if broken[name] is not None:
            failed.append('%s (%s)' % (name, broken[name]))
            status.append({'name': name, 'state': 'failed', 'detail': broken[name]})
        continue
    cached = os.path.join(cache, plugin['key'])
    if name not in built:
        from_cache.append(name)
    for f in binaries(cached):
        target = os.path.join(out, 'frameworks', f)
        if os.path.exists(target):
            continue
        clone(os.path.join(cached, f), target)
    library = os.path.join(out, 'frameworks', name + '.framework', name)
    if plugin['class'] is None:
        entries.append({'name': name, 'library': library, 'ffi': True})
    else:
        entries.append({'name': name, 'library': library, 'class': plugin['class'], 'module': name})

json.dump({'flutter_framework': flutter_framework, 'plugins': entries, 'status': status},
          open(os.path.join(out, 'manifest.json'), 'w'), indent=1)
parts = []
if built:
    parts.append('%d built: %s' % (len(built), ', '.join(built)))
if from_cache:
    parts.append('%d from the cache: %s' % (len(from_cache), ', '.join(from_cache)))
if empty:
    parts.append('%d built nothing: %s' % (len(empty), ', '.join(empty)))
if failed:
    parts.append('%d failed: %s' % (len(failed), '; '.join(failed)))
if not parts:
    parts.append('none to build')
print('🦝 native plugins ready in %.1f s: ' % (time.time() - started) + '; '.join(parts), file=sys.stderr)
PY
}

# Code assets of packages with build hooks (native assets: objective_c
# under path_provider_foundation, sqlite3 3.x), built for this host. The
# tool builds the bundle for the Linux device it believes Raccoon to be (#1)
# without running the hooks for this machine, so its NativeAssetsManifest.json
# names none. The tool's own bundle target for this host runs them: on macOS
# the macOS one, without the app's macos/ directory; on Linux the Linux one,
# which unpacks the GTK engine into linux/flutter/ephemeral, a folder that
# goes again when the project had no linux/ of its own (#57). The code assets
# land beside the app's bundle, and the installed manifest names them by
# absolute path under this host's key, so the engine opens them as an app's
# would. Skipped without hook packages.
build_native_assets() {
  local project="$1" app="$2" config out log manifest built had_linux
  local -a target
  config="$(package_config "$project")"
  [ -n "$config" ] || return 0
  out="$project/build/raccoon/native_assets"
  case "$(uname -s)" in
    Darwin)
      local arch=x86_64
      [ "$(uname -m)" = arm64 ] && arch=arm64
      target=(-dTargetPlatform=darwin -dDarwinArchs="$arch" debug_macos_bundle_flutter_assets)
      manifest="$out/App.framework/Resources/flutter_assets/NativeAssetsManifest.json"
      built="$out/native_assets"
      ;;
    Linux)
      local platform=linux-x64
      case "$(uname -m)" in aarch64|arm64) platform=linux-arm64 ;; esac
      target=(-dTargetPlatform="$platform" "debug_bundle_${platform}_assets")
      manifest="$out/flutter_assets/NativeAssetsManifest.json"
      built="$out/native_assets/linux"
      ;;
    *) return 0 ;;
  esac
  # What the build depends on, as one hash; none when no package has a hook.
  # The packages and their versions, the pubspecs (the workspace root's too),
  # the SDK's engine, the target, and every file of every package with a
  # hook and of the local packages those depend on, by path, time and size,
  # so an edit, a new file or one gone builds again (#111). A last build
  # whose libraries went missing never matches.
  local inputs scan=0
  inputs="$(python3 - "$config" "$project" "$(sdk_root)" "${target[*]}" "$manifest" "$built" <<'PY'
import hashlib, json, os, sys
from urllib.parse import unquote, urlparse
config, project, sdk, target, manifest, built = sys.argv[1:7]
dart_tool = os.path.dirname(os.path.abspath(config))
# The pub graph and the root's pubspecs sit where pub resolved: the project,
# or a workspace root above it (whose member's config is a scoped copy).
root_project = os.path.abspath(project)
here = root_project
while True:
    if os.path.isfile(os.path.join(here, '.dart_tool', 'package_graph.json')):
        root_project = here
        break
    parent = os.path.dirname(here)
    if parent == here:
        break
    here = parent
digest = hashlib.sha256(target.encode())
for path in (config, os.path.join(project, 'pubspec.lock'), os.path.join(project, 'pubspec.yaml'),
             os.path.join(root_project, 'pubspec.lock'), os.path.join(root_project, 'pubspec.yaml'),
             os.path.join(sdk, 'bin', 'cache', 'engine.stamp')):
    if os.path.isfile(path):
        digest.update(path.encode('utf-8', 'surrogateescape'))
        digest.update(open(path, 'rb').read())
roots = {}
for package in json.load(open(config)).get('packages', []):
    uri = package.get('rootUri', '')
    roots[package.get('name')] = unquote(urlparse(uri).path) if uri.startswith('file://') else os.path.normpath(os.path.join(dart_tool, unquote(uri)))
hooked = [name for name, root in roots.items() if os.path.isfile(os.path.join(root, 'hook', 'build.dart'))]
if not hooked:
    sys.exit(3)
# The packages a hook package depends on, directly or not, from the pub
# graph; the local ones count file by file, as the hook packages do. A
# hosted or SDK package changes only with its version, in the config.
graph = {}
try:
    for package in json.load(open(os.path.join(root_project, '.dart_tool', 'package_graph.json'))).get('packages', []):
        graph[package.get('name')] = package.get('dependencies', [])
except (OSError, ValueError):
    pass
pub_cache = os.path.realpath(os.environ.get('PUB_CACHE') or os.path.join(os.path.expanduser('~'), '.pub-cache'))
immutable = (pub_cache + os.sep, os.path.realpath(sdk) + os.sep)
scanned = []
pending = list(hooked)
while pending:
    name = pending.pop()
    if name in scanned or name not in roots:
        continue
    scanned.append(name)
    pending.extend(graph.get(name, []))
for name in sorted(scanned):
    root = roots[name]
    if name not in hooked and os.path.realpath(root).startswith(immutable):
        continue
    digest.update(('%s %s\n' % (name, root)).encode('utf-8', 'surrogateescape'))
    seen = set()
    for directory, names, files in os.walk(root, followlinks=True):
        real = os.path.realpath(directory)
        if real in seen or (directory != root and (real.startswith(immutable) or real + os.sep in immutable)):
            names[:] = []
            continue
        seen.add(real)
        # Left out: hidden folders (.dart_tool, .git, .fvm), the package's
        # own build output, Flutter's generated ephemeral folders, and
        # packages nested in it, such as an example app, whose build output
        # changes with every run.
        top = directory == root
        names[:] = sorted(
            n for n in names
            if not n.startswith('.') and n != 'ephemeral' and not (top and n == 'build')
            and not os.path.isfile(os.path.join(directory, n, 'pubspec.yaml')))
        for file in sorted(files):
            path = os.path.join(directory, file)
            try:
                # lstat: a link counts as itself, a dangling one too.
                stat = os.lstat(path)
            except OSError:
                continue
            digest.update(('%s %d %d\n' % (os.path.relpath(path, root), stat.st_mtime_ns, stat.st_size)).encode('utf-8', 'surrogateescape'))
try:
    for assets in json.load(open(manifest)).get('native-assets', {}).values():
        for path in assets.values():
            if len(path) == 2 and path[0] == 'absolute' and not os.path.isabs(path[1]) \
                    and not os.path.exists(os.path.join(built, path[1])):
                digest.update(b'missing')
except (OSError, ValueError):
    pass
print(digest.hexdigest())
PY
)" || scan=$?
  # 3: no package has a hook. Any other failure: build, and keep no stamp.
  [ "$scan" -eq 3 ] && return 0
  if [ ! -f "$project/lib/main.dart" ]; then
    echo "🦝 native assets skipped: no lib/main.dart to build them with" >&2
    return 0
  fi
  log="$app/native_assets.log"
  mkdir -p "$out"
  local status=0 started unchanged="" stamp="$out/raccoon_inputs"
  started="$(python3 -c 'import time; print(time.time())')"
  if [ -n "$inputs" ] && [ -f "$manifest" ] && [ -f "$stamp" ] && [ "$(cat "$stamp")" = "$inputs" ]; then
    unchanged=1
  else
    rm -f "$stamp"
    had_linux=""
    [ -d "$project/linux" ] && had_linux=1
    (cd "$project" && "$(sdk_root)/bin/flutter" assemble --no-version-check \
      -dBuildMode=debug -dTargetFile=lib/main.dart --output="$out" \
      "${target[@]}") > "$log" 2>&1 || status=$?
    # The Linux target's engine copy, in a project that had no linux/ before.
    if [ "$(uname -s)" = Linux ] && [ -z "$had_linux" ] && [ -d "$project/linux/flutter/ephemeral" ]; then
      rm -rf "$project/linux"
    fi
    if [ "$status" -ne 0 ] || [ ! -f "$manifest" ]; then
      echo "🦝 native assets did not build; see $log" >&2
      return 0
    fi
    [ -n "$inputs" ] && echo "$inputs" > "$stamp"
  fi
  python3 - "$manifest" "$built" "$app" "$started" "$unchanged" <<'PY'
import json, os, shutil, subprocess, sys, time
manifest_path, built, app, started, unchanged = sys.argv[1:6]

def clone(source, target):
    # A copy-on-write clone where the file system has one, so an install
    # writes no bytes (#115); a plain copy otherwise.
    flag = {'darwin': '-c', 'linux': '--reflink=auto'}.get(sys.platform)
    if flag and subprocess.run(['cp', flag, '-R', source, target],
                               stderr=subprocess.DEVNULL).returncode == 0:
        return
    if os.path.isdir(source) and not os.path.islink(source):
        shutil.rmtree(target, ignore_errors=True)
        shutil.copytree(source, target, symlinks=True)
    else:
        shutil.copy2(source, target)

manifest = json.load(open(manifest_path))
installed = os.path.join(app, 'native_assets')
shutil.rmtree(installed, ignore_errors=True)
if os.path.isdir(built):
    clone(built, installed)
count = 0
for assets in manifest.get('native-assets', {}).values():
    for asset, path in assets.items():
        # A framework or library the build installed: by absolute path from
        # where it now is. System and process lookups stay as they are.
        if len(path) == 2 and path[0] == 'absolute' and not os.path.isabs(path[1]):
            assets[asset] = ['absolute', os.path.join(installed, path[1])]
        count += 1
json.dump(manifest, open(os.path.join(app, 'flutter_assets', 'NativeAssetsManifest.json'), 'w'))
print('🦝 native assets ready in %.1f s, %d for this host%s' % (
    time.time() - float(started), count, ', unchanged since the last build' if unchanged else ''), file=sys.stderr)
PY
}

case "$verb" in
  ping)
    test -x "$RUNNER"
    ;;
  prebuild)
    # The plugins a project resolves (its pubspec names them), built into
    # an archive for the release: the cache's layout, so an install drops
    # it straight in. For CI; needs the Flutter SDK for the pub get.
    project="$1"; archive="$2"
    (cd "$project" && flutter pub get > /dev/null)
    stage="$(mktemp -d)"
    RACCOON_PLUGIN_CACHE="$stage/cache" RACCOON_NO_PREBUILT=1 build_plugins "$(cd "$project" && pwd)" "$stage/out"
    mkdir -p "$(dirname "$archive")"
    if [ -d "$stage/cache" ]; then
      # No AppleDouble ._ files for extended attributes: macOS's tar adds
      # them, and they are no frameworks.
      COPYFILE_DISABLE=1 tar -C "$stage/cache" -czf "$archive" .
      echo "🦝 $(find "$stage/cache" \( -name '*.so' -o -name '*.framework' \) -prune | wc -l | tr -d ' ') libraries in $archive"
    else
      echo "🦝 nothing prebuilt" >&2
    fi
    rm -rf "$stage"
    ;;
  install)
    local_path="$1"; key="$(app_key "$2")"
    rm -rf "$APPS/$key"
    mkdir -p "$APPS/$key"
    clone_tree "$local_path" "$APPS/$key/flutter_assets"
    # The project is two levels above its bundle; its native plugins are
    # built for this host and loaded into the runner.
    build_plugins "$(cd "$local_path/../.." && pwd)" "$APPS/$key/plugins"
    build_native_assets "$(cd "$local_path/../.." && pwd)" "$APPS/$key"
    ;;
  uninstall)
    rm -rf "$APPS/$(app_key "$1")"
    ;;
  run)
    key="$(app_key "$1")"; shift
    if [ ! -d "$APPS/$key/flutter_assets" ]; then
      echo "🦝 $key is not installed: flutter run -d raccoon installs it, or raccoon-device install" >&2
      exit 1
    fi
    mkdir -p "$SOCKETS" "$DATA/$key"
    # The run's output, timestamped, for the run that went wrong; the tool
    # keeps reading the untouched streams.
    log="$DATA/$key/runner.log"
    : > "$log"
    manifest="$APPS/$key/plugins/manifest.json"
    [ -f "$manifest" ] || manifest=""
    # Without a size of the device's own, the size the board last gave this
    # app (raccoon_runtime's AppSizes), so it opens as it was left (#89).
    if [ -z "$SIZE" ] && [ -f "$DATA/$key/size" ]; then
      saved="$(tr -d '[:space:]' < "$DATA/$key/size")"
      if [[ "$saved" =~ ^[0-9]+x[0-9]+(@[0-9]+(\.[0-9]+)?)?$ ]]; then SIZE="$saved"; fi
    fi
    size_args=""
    if [ -n "$SIZE" ]; then
      w="${SIZE%%x*}"; rest="${SIZE#*x}"; h="${rest%%@*}"; r="${rest#*@}"
      [ "$r" = "$rest" ] && r=1
      # The size is logical; the runner takes pixels.
      size_args="$(awk -v w="$w" -v h="$h" -v r="$r" \
        'BEGIN { printf "--width %d --height %d --dpr %s", w * r + 0.5, h * r + 0.5, r }')"
    fi
    # FFI plugins' libraries, opened by the Dart side by name: on Linux by
    # library name, on macOS as <name>.framework/<name>, on Windows as a DLL
    # on the PATH.
    if [ -d "$APPS/$key/plugins/lib" ]; then
      if [ -n "$WINDOWS" ]; then
        PATH="$(cygpath -u "$APPS/$key/plugins/lib"):$PATH"
        export PATH
      else
        export LD_LIBRARY_PATH="$APPS/$key/plugins/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
      fi
    fi
    if [ -d "$APPS/$key/plugins/frameworks" ]; then
      export DYLD_FRAMEWORK_PATH="$APPS/$key/plugins/frameworks${DYLD_FRAMEWORK_PATH:+:$DYLD_FRAMEWORK_PATH}"
      # A vendored library the app opens by name (isar's libisar.dylib), as
      # an app's bundle would have it (#93).
      export DYLD_LIBRARY_PATH="$APPS/$key/plugins/frameworks${DYLD_LIBRARY_PATH:+:$DYLD_LIBRARY_PATH}"
    fi
    binary="$RUNNER"
    if [ "$(uname -s)" = Darwin ] && { [ -n "$manifest" ] || [ -d "$APPS/$key/native_assets" ]; }; then
      binary="$(app_bundle "$key")"
    fi
    # The runner is this script's child rather than its replacement, so a
    # runner that dies (a native crash in a plugin, say) says how in the
    # tool's output. The tool stops a run by stopping this script, which
    # passes it on; the runner watches the tool itself, which may go
    # without a word.
    # Before the runner: an engine that can't be had stops the run with
    # engine_dir.sh's word on why, not with the runner's usage (#119).
    engine_dir="$("$ROOT/tool/engine_dir.sh")" || exit 1
    if [ ! -x "$binary" ]; then
      echo "🦝 no runner at $binary: build native/raccoon_runner, or set RACCOON_RUNNER" >&2
      exit 1
    fi
    export RACCOON_PARENT_PID="$PPID"
    # The tool passes its engine switches as one argument; split on spaces.
    # shellcheck disable=SC2068
    "$binary" serve \
      --engine-dir "$engine_dir" \
      --assets "$APPS/$key/flutter_assets" \
      --icu "$(sdk_icu)" \
      --socket "$(socket_path "$key")" \
      --data-dir "$DATA/$key" \
      ${manifest:+--plugins "$manifest"} \
      $size_args \
      -- $@ \
      > >(tee >(stamp >> "$log")) \
      2> >(tee >(stamp >> "$log") >&2) &
    runner=$!
    trap 'kill -TERM "$runner" 2>/dev/null' TERM INT HUP
    # A signal cuts the wait short; the runner is gone once kill -0 says so
    # (until it is waited for, an exited runner still answers).
    while :; do
      status=0
      wait "$runner" 2>/dev/null || status=$?
      kill -0 "$runner" 2>/dev/null || break
    done
    said=""
    if [ "$status" -gt 128 ]; then
      said="🦝 raccoon_runner died of signal $(kill -l $((status - 128)) 2>/dev/null || echo '?') ($((status - 128)))"
    elif [ "$status" -ne 0 ]; then
      said="🦝 raccoon_runner exited with code $status"
    fi
    if [ -n "$said" ]; then
      echo "$said" >&2
      echo "$said" | stamp >> "$log"
    fi
    exit "$status"
    ;;
  *)
    echo "usage: raccoon-device ping | install [--instance KEY] <localPath> <appName> | uninstall [--instance KEY] <appName> | run [--instance KEY] [--size WxH@R] <appName> [engine switches] | prebuild <project> <archive.tar.gz>" >&2
    exit 2
    ;;
esac
