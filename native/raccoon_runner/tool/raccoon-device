# A plugin that failed to build is kept failed, as on macOS (#136): by
# its key and the compiler and CMake, for a day, never with
# RACCOON_RETRY_PLUGINS=1, and never for a missing toolchain.
FAILURE_DAYS = 1
toolchain_id = None


def toolchain_identity():
    global toolchain_id
    if toolchain_id is None:
        import shlex
        versions = []
        # The compilers CMake picks ($CC else cc, $CXX else c++, either
        # perhaps behind ccache), and the JDK a plugin that made nothing
        # without one (jni) wants.
        for command in ('cmake', os.environ.get('CC') or 'cc', os.environ.get('CXX') or 'c++'):
            try:
                found = subprocess.run(shlex.split(command) + ['--version'],
                                       capture_output=True, text=True).stdout
                versions.append(found.splitlines()[0] if found else '')
            except (OSError, IndexError, ValueError):
                versions.append('')
        javac = shutil.which('javac')
        versions.append(os.environ.get('JAVA_HOME') or (os.path.realpath(javac) if javac else ''))
        toolchain_id = ' / '.join(versions)
    return toolchain_id


def failure_path(plugin):
    return os.path.join(cache, 'failed', plugin['key'] + '.json')


def kept_failure(plugin):
    """How [plugin] went last time, its state and why, when that still
    holds; else None."""
    if os.environ.get('RACCOON_RETRY_PLUGINS') == '1':
        return None
    try:
        with open(failure_path(plugin)) as f:
            kept = json.load(f)
    except (OSError, ValueError):
        return None
    if time.time() - kept.get('at', 0) > FAILURE_DAYS * 86400:
        return None
    if kept.get('toolchain') != toolchain_identity():
        return None
    return kept.get('state', 'failed'), '%s (kept from %s; RACCOON_RETRY_PLUGINS=1 builds it again)' % (
        kept.get('why', 'failed'), time.strftime('%Y-%m-%d %H:%M', time.localtime(kept['at'])))


# What says the machine stopped a build, not the plugin: a full disk, an
# interrupted build, a compiler killed for memory, or no network for a
# fetch (a Swift package, a pod's CDN, a CMake download step).
STOPPED = ('No space left on device', 'disk I/O error', '** BUILD INTERRUPTED **',
           'ninja: build stopped: interrupted', 'Killed signal terminated program',
           'Could not resolve host', 'The Internet connection appears to be offline',
           'The network connection was lost', 'Connection timed out', 'Failed to connect to',
           'Temporary failure in name resolution', "CDN: trunk URL couldn't be downloaded",
           'The request timed out.')


def machine_stopped(log):
    text = open(log, errors='replace').read()
    return any(sign in text for sign in STOPPED)


def keep_failure(plugin, why, log, state='failed'):
    """Keeps [plugin]'s failure, with a copy of [log] beside it, which the
    reason names: the install's own is written over by the next. Not one
    the machine stopped (a full disk, an interrupted build): the plugin
    would be held back for nothing. One that built nothing is kept the
    same way, so every install does not build it again."""
    if os.path.isfile(log) and machine_stopped(log):
        return
    record = failure_path(plugin)
    os.makedirs(os.path.dirname(record), exist_ok=True)
    if os.path.isfile(log):
        kept_log = record[:-len('.json')] + '.log'
        shutil.copyfile(log, kept_log)
        why = why.replace(log, kept_log)
    staging = record + '.partial-%d' % os.getpid()
    with open(staging, 'w') as f:
        json.dump({'why': why, 'at': time.time(), 'toolchain': toolchain_identity(), 'state': state}, f)
    os.replace(staging, record)


# A few plugins build at once (CMake's configure is mostly one process),
# each with its share of the cores and ninja's two more for the waits on
# disk: ninja's own width is all of them.
WORKERS = max(1, min(4, (os.cpu_count() or 2) // 2))
JOBS = (os.cpu_count() or 2) // WORKERS + 2


def build(plugin):
    """Configures and builds [plugin] in a CMake project of its own, and
    caches what it made: its state ('built', 'failed' or
    'built_nothing'), why, and its cached libraries."""
    name = plugin['name']
    cached = os.path.join(cache, plugin['key'])
    project = os.path.join(out, 'build', name)
    os.makedirs(project, exist_ok=True)
    with open(os.path.join(project, 'CMakeLists.txt'), 'w') as f:
        f.write(PREAMBLE)
        f.write('add_subdirectory("%s" "plugin")\n' % os.path.join(plugin['root'], 'linux'))
        # As the list it is, ;-separated: a $<JOIN> would take a comma in a
        # path for its own and fail on a >.
        f.write('file(GENERATE OUTPUT "${CMAKE_BINARY_DIR}/bundled.txt" '
                'CONTENT "${%s_bundled_libraries}")\n' % name)
    log = os.path.join(project, 'build.log')
    with open(log, 'w') as written:
        configured = subprocess.run(['cmake', '-S', project, '-B', os.path.join(project, 'out'), '-G', 'Ninja'],
                                    stdout=written, stderr=subprocess.STDOUT).returncode == 0
        ok = configured and subprocess.run(['cmake', '--build', os.path.join(project, 'out'),
                                            '--parallel', str(JOBS)],
                                           stdout=written, stderr=subprocess.STDOUT).returncode == 0
    if not ok:
        why = 'did not build; see ' + log
        # Not one CMake stopped configuring: that is a missing package
        # (a -dev one), which the next install should find once it is in.
        if configured:
            keep_failure(plugin, why, log)
        return 'failed', why, []
    # What its targets built, and what it bundles; a name once.
    libs = {}
    for so in sorted(glob.glob(os.path.join(project, 'out', 'plugin', '**', '*.so'), recursive=True)) + bundled(project):
        libs.setdefault(os.path.basename(so), so)
    if not libs:
        # Built fine and made nothing: an FFI plugin whose library wants
        # a toolchain this machine has not (jni without a JDK).
        why = 'built and made no library'
        keep_failure(plugin, why, log, 'built_nothing')
        shutil.rmtree(project, ignore_errors=True)
        return 'built_nothing', why, []
    # Copied aside, then renamed into place: an interrupted copy leaves
    # no entry that counts as cached (#122).
    os.makedirs(cache, exist_ok=True)
    staging = tempfile.mkdtemp(prefix=os.path.basename(cached) + '.partial-', dir=cache)
    for so in libs.values():
        shutil.copy2(so, staging)
    settle(staging, cached, lambda: libraries(cached))
    # Its build tree, once cached: the next install starts afresh.
    shutil.rmtree(project, ignore_errors=True)
    return 'built', None, libraries(cached)


os.makedirs(os.path.join(out, 'lib'), exist_ok=True)
built, failed, empty, from_cache, skipped = [], [], [], [], []
entries = []
toolchain = None  # looked up when a build is needed
cached_only = os.environ.get('RACCOON_PLUGINS') == 'cached'
# Each plugin's state, why and libraries; the ones to build wait for them.
outcome = {}
misses = []
for plugin in wanted:
