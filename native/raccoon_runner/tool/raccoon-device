# Instances of one project (raccoon, raccoon-2) share its build/raccoon: a
# workspace member's scoped package config, the native assets and their
# stamp. Installs that write there take turns, until the helper exits
# (#136); a lock whose holder is gone is a killed install's. Taken only
# then, so an app with neither pays nothing for it.
lock_build() {
  [ -z "${BUILD_LOCK:-}" ] || return 0
  BUILD_LOCK="$1/build/raccoon/.install-lock"
  [ -d "$1/build/raccoon" ] || mkdir -p "$1/build/raccoon"
  # The holder's pid is in the lock: one whose holder is gone is stale, and
  # an exit takes away only its own. A cold build can hold it for longer
  # than ten minutes (#225); an hour is past any, and frees a lock whose
  # killed holder's pid went to another process since.
  local holder
  until mkdir "$BUILD_LOCK" 2>/dev/null; do
    holder="$(cat "$BUILD_LOCK/pid" 2>/dev/null || true)"
    if { [ -n "$holder" ] && ! kill -0 "$holder" 2>/dev/null; } ||
       { [ -z "$holder" ] && [ -n "$(find "$BUILD_LOCK" -maxdepth 0 -mmin +10 2>/dev/null)" ]; } ||
       [ -n "$(find "$BUILD_LOCK" -maxdepth 0 -mmin +60 2>/dev/null)" ]; then
      rm -f "$BUILD_LOCK/pid"
      rmdir "$BUILD_LOCK" 2>/dev/null || true
      continue
    fi
    sleep 0.2
  done
  echo $$ > "$BUILD_LOCK/pid"
  trap '[ "$(cat "$BUILD_LOCK/pid" 2>/dev/null)" = $$ ] && rm -f "$BUILD_LOCK/pid" && rmdir "$BUILD_LOCK" 2>/dev/null' EXIT
}

# A linux/ holding only flutter/ephemeral is the Linux target's engine copy,
# which assemble makes in a project with no Linux app of its own (one has
# CMakeLists.txt and runner/). Cleared before and after the build, so one an
# install killed mid-build left goes too (#136).
clear_assembled_linux() {
  local linux="$1/linux"
  [ "$(uname -s)" = Linux ] || return 0
  [ "$(ls -A "$linux" 2>/dev/null)" = flutter ] || return 0
  [ "$(ls -A "$linux/flutter")" = ephemeral ] || return 0
  rm -rf "$linux"
}

# Code assets of packages with build hooks (native assets: objective_c
# under path_provider_foundation, sqlite3 3.x), built for this host. The
# tool builds the bundle for the Linux device it believes Raccoon to be (#1)
# without running the hooks for this machine, so its NativeAssetsManifest.json
# names none. The tool's own bundle target for this host runs them: on macOS
# the macOS one, without the app's macos/ directory; on Linux the Linux one,
# which unpacks the GTK engine into linux/flutter/ephemeral, a folder that
# goes again when the project had no linux/ of its own (#57, #136). The code assets
# land beside the app's bundle, and the installed manifest names them by
# absolute path under this host's key, so the engine opens them as an app's
# would. Skipped without hook packages.
build_native_assets() {
