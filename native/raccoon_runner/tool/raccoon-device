json.dump({'plugins': entries, 'status': status, 'library_path': os.path.join(out, 'lib')},
          open(os.path.join(out, 'manifest.json'), 'w'), indent=1)
parts = []
if built:
    parts.append('%d built: %s' % (len(built), ', '.join(built)))
if from_cache:
