# The macOS half: the resolved packages whose pubspec names a macOS
# pluginClass (registered) or ffiPlugin (opened only, for Dart to find),
# their pods built against the SDK's FlutterMacOS.framework.
# One CocoaPods project for what the cache misses (never integrated into a
# target, so it needs no Xcode project of the app's or its own), then
# each plugin's pod target on its own, so one that fails sinks nothing else;
# its framework and those of the pods it depends on are cached by plugin
# version, runner version, engine and architecture, and what the release
# prebuilt comes from its archive, fetched once. Every framework lands
# flat in |out|/frameworks, where they find each other by @loader_path; the
# manifest names the SDK's FlutterMacOS for the runner to open first.
build_plugins_macos() {
  local project="$1" out="$2" config="$3" sdk engine version cache
  sdk="$(sdk_root)"
  engine="$(engine_revision)"
  version="$(tr -d '[:space:]' < "$ROOT/VERSION")"
  cache="${RACCOON_PLUGIN_CACHE:-${XDG_CACHE_HOME:-$HOME/.cache}/raccoon/plugins/$engine}"
  python3 - "$config" "$out" "$VIRTUAL_PLUGINS_MACOS" \
    "$cache" "$version" "$(uname -m)" "$sdk/bin/cache/artifacts/engine/darwin-x64" \
    "${RACCOON_PREBUILT_PLUGINS:-https://github.com/SoFluffyOS/raccoon/releases/download/runner-v$version/plugins-$engine-macos-$(uname -m).tar.gz}" \
    "$project" <<'PY'
import glob, hashlib, json, os, re, shutil, subprocess, sys, tarfile, tempfile, time
started = time.time()
from urllib.parse import unquote, urlparse

def drop(*paths):
    """A plugin's build intermediates, once it is cached or has failed: the
    next install starts from an empty folder, and Firestore's are 1.7 GB
    (#184)."""
    for path in paths:
        shutil.rmtree(path, ignore_errors=True)

def settle(staging, cached, good):
    """Renames [staging] into place as [cached], each install staging on
    its own: an install that finished the same entry first keeps it (#136)."""
    if good():
        shutil.rmtree(staging, ignore_errors=True)
        return
    shutil.rmtree(cached, ignore_errors=True)
    try:
        os.replace(staging, cached)
    except OSError:
        # Another install put its entry there between the two.
        shutil.rmtree(staging, ignore_errors=True)


def clone(source, target):
    # A copy-on-write clone where the file system has one, so an install
    # writes no bytes (#115); a plain copy otherwise.
    flag = {'darwin': '-c', 'linux': '--reflink=auto'}.get(sys.platform)
    if flag and subprocess.run(['cp', flag, '-R', source, target],
                               stderr=subprocess.DEVNULL).returncode == 0:
        return
    if os.path.isdir(source) and not os.path.islink(source):
        shutil.rmtree(target, ignore_errors=True)
        shutil.copytree(source, target, symlinks=True)
    else:
        shutil.copy2(source, target)

import concurrent.futures
config, out, virtual, cache, runner_version, arch, engine_dir, prebuilt_url, project = sys.argv[1:10]
# What an install that may only take the cache says of the rest (#214).
SKIPPED = 'not built: native plugins are cached only (RACCOON_PLUGINS=cached)'
cached_only = os.environ.get('RACCOON_PLUGINS') == 'cached'
virtual = set(virtual.split())
dart_tool = os.path.dirname(os.path.abspath(config))
# What flutter precache --macos ships: the xcframework, no podspec (one in
# an SDK's cache is a leftover of older flows, as is a bare framework).
xcframework = os.path.join(engine_dir, 'FlutterMacOS.xcframework')
flutter_framework = os.path.join(xcframework, 'macos-arm64_x86_64', 'FlutterMacOS.framework', 'FlutterMacOS')
env = dict(os.environ, LANG='en_US.UTF-8', LC_ALL='en_US.UTF-8')


def platform_block(pubspec, platform):
    found = re.search(r'^([ \t]*)%s:[ \t]*\n' % platform, pubspec, re.M)
    if not found:
        return ''
    indent = len(found.group(1))
    block = []
    for line in pubspec[found.end():].splitlines():
        if not line.strip():
            continue
        if len(line) - len(line.lstrip()) <= indent:
            break
        block.append(line)
    return '\n'.join(block)


def version_key(name, root, sources):
    # A hosted package is its directory name, name-version. A git one is its
    # place in the cache, which names the commit. A path package is the shape
    # of its native side, so an edit rebuilds it: every file but its Dart
    # code, tests, examples, build output and hidden folders, so the shared
    # sources an FFI plugin builds (src/) count too (#121).
    real = os.path.realpath(root)
    cache_marker = os.sep + '.pub-cache' + os.sep
    if cache_marker + 'hosted' + os.sep in real + os.sep:
        return os.path.basename(real.rstrip(os.sep))
    if cache_marker in real + os.sep:
        place = real.split(cache_marker, 1)[1]
        return '%s-git-%s' % (name, hashlib.sha256(place.encode('utf-8', 'surrogateescape')).hexdigest()[:16])
    digest = hashlib.sha256()
    for dirpath, dirs, files in os.walk(root):
        top = dirpath == root
        dirs[:] = sorted(d for d in dirs if not d.startswith('.')
                         and not (top and d in ('lib', 'test', 'example', 'build'))
                         and not os.path.isfile(os.path.join(dirpath, d, 'pubspec.yaml')))
        for f in sorted(files):
            full = os.path.join(dirpath, f)
            try:
                st = os.lstat(full)
            except OSError:
                continue
            digest.update(('%s %d %d\n' % (os.path.relpath(full, root), st.st_size, int(st.st_mtime))).encode('utf-8', 'surrogateescape'))
    return '%s-path-%s' % (name, digest.hexdigest()[:16])


def can_build():
    if shutil.which('pod') is None:
        return 'no CocoaPods (pod)'
    if subprocess.run(['xcodebuild', '-version'], stdout=subprocess.DEVNULL,
                      stderr=subprocess.DEVNULL).returncode != 0:
        return 'no Xcode (xcodebuild)'
    if not os.path.isfile(flutter_framework):
        return 'no FlutterMacOS in the SDK (flutter precache --macos)'
    return None


def dependencies(pubspec):
    found = re.search(r'^dependencies:[ \t]*\n', pubspec, re.M)
    if not found:
        return set()
    names = set()
    # The entries sit at the indentation of the first, two spaces, four or
    # a tab; deeper lines are an entry's own keys (path:, git:).
    level = None
    for line in pubspec[found.end():].splitlines():
        if not line.strip() or line.lstrip().startswith('#'):
            continue
        if not line.startswith((' ', '\t')):
            break
        indent = line[:len(line) - len(line.lstrip())]
        if level is None:
            level = indent
        if indent != level:
            continue
        named = re.match(r'[ \t]*(\w+):', line)
        if named:
            names.add(named.group(1))
    return names


swept = False


def sweep_staging():
    """What an install killed mid-copy left in the cache: entries and records
    being staged, prebuilt archives being unpacked. An hour old, so none
    another install is still filling (#226). Once an install."""
    global swept
    if swept:
        return
    swept = True
    now = time.time()
    for folder in (cache, os.path.join(cache, 'failed')):
        try:
            names = os.listdir(folder)
        except OSError:
            continue
        for name in names:
            if '.partial-' not in name and not name.startswith('.prebuilt-'):
                continue
            path = os.path.join(folder, name)
            try:
                if now - os.lstat(path).st_mtime < 3600:
                    continue
                if os.path.isdir(path) and not os.path.islink(path):
                    shutil.rmtree(path, ignore_errors=True)
                else:
                    os.remove(path)
            except OSError:
                pass


prebuilt_tried = False


def fetch_prebuilt():
    """The release's prebuilt plugins into the cache, once per runner version
    and engine; a marker remembers a miss so it is not asked again."""
    global prebuilt_tried
    if os.environ.get('RACCOON_NO_PREBUILT') or prebuilt_tried:
        return
    # Once an install: a network that fails fails for every plugin alike.
    prebuilt_tried = True
    # By architecture too: an x86_64 install (Rosetta) has its own archive.
    marker = os.path.join(cache, 'prebuilt-%s-macos-%s.done' % (runner_version, arch))
    if os.path.exists(marker):
        return
    os.makedirs(cache, exist_ok=True)
    # Unpacked aside, then moved in entry by entry: an interrupted fetch
    # leaves no half entry that would count as cached (#122).
    import tempfile
    staging = tempfile.mkdtemp(prefix='.prebuilt-', dir=cache)
    archive = os.path.join(staging, 'archive.tar.gz')
    # Remembered: the fetch, no archive for this version, or a broken one.
    # Not a network failure, a dropped connection or a server error: the
    # next install asks again.
    remember = False
    try:
        # Only when downloading: importing it costs every install 20 ms.
        import gzip, socket, urllib.error, urllib.request, zlib
        # A stalled connection fails rather than holding the install.
        socket.setdefaulttimeout(30)
        try:
            urllib.request.urlretrieve(prebuilt_url, archive)
        except urllib.error.HTTPError as error:
            remember = error.code == 404
            raise
        try:
            with tarfile.open(archive) as tar:
                # Frameworks, with their symlinks; nothing that would land or
                # point outside the cache.
                if hasattr(tarfile, 'data_filter'):
                    tar.extractall(staging, filter='data')
                else:
                    members = [m for m in tar.getmembers()
                               if not m.name.startswith('/') and '..' not in m.name.split('/')
                               and not (m.issym() and (m.linkname.startswith('/') or '..' in m.linkname.split('/')[:-1]))]
                    tar.extractall(staging, members=members)
        except (tarfile.TarError, EOFError, zlib.error, gzip.BadGzipFile):
            remember = True
            raise
        os.remove(archive)
        for entry in os.listdir(staging):
            if not os.path.exists(os.path.join(cache, entry)):
                os.replace(os.path.join(staging, entry), os.path.join(cache, entry))
        print('🦝 prebuilt plugins fetched for runner %s' % runner_version, file=sys.stderr)
        remember = True
    except Exception:
        pass
    finally:
        shutil.rmtree(staging, ignore_errors=True)
    if remember:
        open(marker, 'w').close()


def frameworks(directory):
    return sorted(f for f in os.listdir(directory)
                  if f.endswith('.framework') and not f.startswith('._')) if os.path.isdir(directory) else []


def binaries(directory):
    """The frameworks and libraries in a cache entry or the install."""
    return sorted(f for f in os.listdir(directory)
                  if f.endswith(('.framework', '.dylib')) and not f.startswith('._')) if os.path.isdir(directory) else []


def binary_of(path):
    """The Mach-O file of a framework, or the library itself."""
    if path.endswith('.dylib'):
        return path
    return os.path.join(path, os.path.basename(path)[:-len('.framework')])


def rpath_needs(binary):
    """The frameworks and libraries [binary] loads by @rpath, by name."""
    listing = subprocess.run(['otool', '-L', binary], capture_output=True, text=True).stdout
    return re.findall(r'@rpath/([^/\s]+\.(?:framework|dylib))', listing)


def vendored(made, roots):
    """What the built frameworks load by @rpath that the build left where a
    pod vendors it, as an app's embed step would copy it: plain frameworks
    (ffmpegkit) and libraries (libisar.dylib), and what they load in turn
    (#93). Looked for under [roots]: the plugin's sources, the pods."""
    present = {os.path.basename(path) for path in made} | {'FlutterMacOS.framework'}
    queue = [binary_of(path) for path in made]
    found = []
    while queue:
        for need in rpath_needs(queue.pop()):
            if need in present:
                continue
            present.add(need)
            path = next((os.path.join(top, need)
                         for root in roots if os.path.isdir(root)
                         for top, dirs, files in os.walk(root, followlinks=True)
                         if need in dirs or need in files), None)
            if path is None:
                continue
            found.append(path)
            queue.append(binary_of(path))
    return found


# A plugin that failed to build is kept failed, so each install does not
# spend minutes on it again (#136): by the key a success would have, so a
# new version, an edited path plugin or a new runner tries again, and by
# the toolchain, so a new Xcode or CocoaPods does; for a day, in case what
# failed was the network; and never with RACCOON_RETRY_PLUGINS=1. A missing
# toolchain is never kept: installing it is the fix.
FAILURE_DAYS = 1
toolchain_id = None


def toolchain_stamp():
    """What changes when Xcode or CocoaPods does, read without running
    either: the selected Xcode and its version file, and pod's resolved
    path, all with their times."""
    parts = []
    developer = os.environ.get('DEVELOPER_DIR') or os.path.realpath('/var/db/xcode_select_link')
    if not os.path.isdir(developer):
        developer = '/Applications/Xcode.app/Contents/Developer'
    pod = shutil.which('pod', path=env.get('PATH'))
    for path in (developer, os.path.join(developer, '..', 'version.plist'),
                 os.path.realpath(pod) if pod else ''):
        try:
            parts.append('%s %d' % (path, os.stat(path).st_mtime_ns))
        except OSError:
            parts.append(path)
    return ' / '.join(parts)


def toolchain_identity():
    """xcodebuild's and pod's versions, which take most of a second to ask
    for: kept in the cache by toolchain_stamp (#225)."""
    global toolchain_id
    if toolchain_id is None:
        stamp = toolchain_stamp()
        kept = os.path.join(cache, 'toolchain.json')
        try:
            with open(kept) as f:
                known = json.load(f)
            if known.get('stamp') == stamp:
                toolchain_id = known['id']
                return toolchain_id
        except (OSError, ValueError, KeyError):
            pass
        versions = []
        for command in (['xcodebuild', '-version'], ['pod', '--version']):
            try:
                versions.append(subprocess.run(command, capture_output=True, text=True, env=env).stdout.strip())
            except OSError:
                versions.append('')
        toolchain_id = ' / '.join(v.replace('\n', ' ') for v in versions)
        # Not kept while either says nothing (Xcode's license not accepted
        # yet, say): accepting it changes no file the stamp reads.
        if not all(versions):
            return toolchain_id
        try:
            os.makedirs(cache, exist_ok=True)
            staging = '%s.%d' % (kept, os.getpid())
            with open(staging, 'w') as f:
                json.dump({'stamp': stamp, 'id': toolchain_id}, f)
            os.replace(staging, kept)
        except OSError:
            pass
    return toolchain_id


def failure_path(plugin):
    return os.path.join(cache, 'failed', plugin['key'] + '.json')


def kept_failure(plugin):
    """Why [plugin] failed last time, when that still holds; else None."""
    if os.environ.get('RACCOON_RETRY_PLUGINS') == '1':
        return None
    try:
        with open(failure_path(plugin)) as f:
            kept = json.load(f)
    except (OSError, ValueError):
        return None
    if time.time() - kept.get('at', 0) > FAILURE_DAYS * 86400:
        return None
    if kept.get('toolchain') != toolchain_identity():
        return None
    return '%s (kept from %s; RACCOON_RETRY_PLUGINS=1 builds it again)' % (
        kept.get('why', 'failed'), time.strftime('%Y-%m-%d %H:%M', time.localtime(kept['at'])))


# What says the machine stopped a build, not the plugin: a full disk, an
# interrupted build, a compiler killed for memory, or no network for a
# fetch (a Swift package, a pod's CDN, a CMake download step).
STOPPED = ('No space left on device', 'disk I/O error', '** BUILD INTERRUPTED **',
           'ninja: build stopped: interrupted', 'Killed signal terminated program',
           'Could not resolve host', 'The Internet connection appears to be offline',
           'The network connection was lost', 'Connection timed out', 'Failed to connect to',
           'Temporary failure in name resolution', "CDN: trunk URL couldn't be downloaded",
           'The request timed out.')


def machine_stopped(log):
    text = open(log, errors='replace').read()
    return any(sign in text for sign in STOPPED)


def keep_failure(plugin, why, log, state='failed'):
    """Keeps [plugin]'s failure, with a copy of [log] beside it, which the
    reason names: the install's own is written over by the next. Not one
    the machine stopped (a full disk, an interrupted build): the plugin
    would be held back for nothing. One that built nothing is kept the
    same way, so every install does not build it again."""
    if log and os.path.isfile(log) and machine_stopped(log):
        return
    record = failure_path(plugin)
    os.makedirs(os.path.dirname(record), exist_ok=True)
    if log and os.path.isfile(log):
        kept_log = record[:-len('.json')] + '.log'
        shutil.copyfile(log, kept_log)
        why = why.replace(log, kept_log)
    staging = record + '.partial-%d' % os.getpid()
    with open(staging, 'w') as f:
        json.dump({'why': why, 'at': time.time(), 'toolchain': toolchain_identity(), 'state': state}, f)
    os.replace(staging, record)


def kept_state(plugin):
    """The state [plugin]'s kept failure was kept as: 'failed', or
    'built_nothing'."""
    try:
        with open(failure_path(plugin)) as f:
            return json.load(f).get('state', 'failed')
    except (OSError, ValueError):
        return 'failed'


def in_cache(plugin):
    """Whether the cache holds the plugin, built against this app's
    dependencies; see [entry_of]."""
    return entry_of(plugin) is not None


def entry_of(plugin):
    """The cache entry that holds [plugin] built against this app's
    dependencies, or None. An entry is the plugin's key, or its key and
    the hash of the dependencies' keys it was built against (#274): two
    apps whose dependencies differ (firebase_core 3 and 4) keep an entry
    each, rather than build each other's again every install."""
    base = os.path.join(cache, plugin['key'])
    variants = sorted(glob.glob(glob.escape(base) + '~*'))
    for entry in [base] + [v for v in variants if '.partial-' not in v]:
        if entry_holds(entry):
            return entry
    return None


def variant_of(plugin, carried):
    """Where [plugin] built against [carried] (dependency: key) goes."""
    base = os.path.join(cache, plugin['key'])
    if not carried:
        return base
    digest = hashlib.sha256(json.dumps(carried, sort_keys=True).encode()).hexdigest()[:12]
    return '%s~%s' % (base, digest)


def entry_holds(entry):
    """Whether [entry] holds a plugin whole, every framework and library its
    frameworks load by @rpath included (helpers before #84 and #93 left out
    the vendored ones), built against this app's dependencies. Checked
    once, then stamped."""
    present = binaries(entry)
    if not any(f.endswith('.framework') for f in present):
        return False
    # An entry carries the plugins its pods depend on (firebase_core with
    # firebase_analytics), recorded with their keys: built against others
    # than this app's, it is built again (#225).
    try:
        with open(os.path.join(entry, '.plugins.json')) as f:
            carried = json.load(f)
    except (OSError, ValueError):
        carried = {}
    if any(current_keys.get(dep, key) != key for dep, key in carried.items()):
        return False
    stamp = os.path.join(entry, '.complete')
    if os.path.exists(stamp):
        return True
    loadable = set(present) | {'FlutterMacOS.framework'}
    for f in present:
        if any(dep not in loadable for dep in rpath_needs(binary_of(os.path.join(entry, f)))):
            return False
    open(stamp, 'w').close()
    return True


SWIFT_FRAMEWORK = 'RaccoonPlugins'


def can_build_packages():
    if shutil.which('xcodebuild') is None or subprocess.run(
            ['xcodebuild', '-version'], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode != 0:
        return 'no Xcode (xcodebuild)'
    if not os.path.isfile(flutter_framework):
        return 'no FlutterMacOS in the SDK (flutter precache --macos)'
    return None


def build_packages(plugins, entry):
    """Builds [plugins]' Swift packages into one framework, cached as
    [entry]: (None, None), or why not and the plugins its errors name. Laid out as Flutter lays them out: each
    plugin by its name beside an empty FlutterFramework package, so their
    ../firebase_core and ../FlutterFramework resolve, and a package of our
    own whose dynamic library depends on every plugin's product. Built with
    xcodebuild: swift build compiles Objective-C that imports a Swift
    module (Firestore's) before that module's -Swift.h exists."""
    work = os.path.join(out, 'build', 'swiftpm')
    shutil.rmtree(work, ignore_errors=True)
    packages_dir = os.path.join(work, 'packages')
    for package in ('FlutterFramework', SWIFT_FRAMEWORK):
        os.makedirs(os.path.join(packages_dir, package, 'Sources', package))
        open(os.path.join(packages_dir, package, 'Sources', package, package + '.swift'), 'w').close()
    for plugin in plugins:
        os.symlink(plugin['package'], os.path.join(packages_dir, plugin['name']))
    with open(os.path.join(packages_dir, 'FlutterFramework', 'Package.swift'), 'w') as f:
        f.write('// swift-tools-version: 5.9\nimport PackageDescription\n\n'
                'let package = Package(\n  name: "FlutterFramework",\n'
                '  products: [.library(name: "FlutterFramework", targets: ["FlutterFramework"])],\n'
                '  targets: [.target(name: "FlutterFramework")]\n)\n')
    macos = subprocess.run(['sw_vers', '-productVersion'], capture_output=True, text=True).stdout.strip()
    with open(os.path.join(packages_dir, SWIFT_FRAMEWORK, 'Package.swift'), 'w') as f:
        f.write('// swift-tools-version: 5.9\nimport PackageDescription\n\n'
                'let package = Package(\n  name: "%s",\n  platforms: [.macOS("%s.0")],\n'
                '  products: [.library(name: "%s", type: .dynamic, targets: ["%s"])],\n'
                '  dependencies: [\n%s  ],\n'
                '  targets: [.target(name: "%s", dependencies: [\n%s  ])]\n)\n' % (
                    SWIFT_FRAMEWORK, macos.split('.')[0] or '11', SWIFT_FRAMEWORK, SWIFT_FRAMEWORK,
                    ''.join('    .package(name: %s, path: %s),\n' % (json.dumps(p['name']), json.dumps('../' + p['name']))
                            for p in plugins),
                    SWIFT_FRAMEWORK,
                    # A plugin's product is its name with hyphens, as Flutter
                    # names it.
                    ''.join('    .product(name: %s, package: %s),\n' % (json.dumps(p['name'].replace('_', '-')), json.dumps(p['name']))
                            for p in plugins)))
    products = os.path.join(work, 'products')
    log_path = os.path.join(work, 'xcodebuild.log')
    with open(log_path, 'w') as log:
        ok = subprocess.run(
            ['xcodebuild', '-scheme', SWIFT_FRAMEWORK, '-configuration', 'Release',
             '-destination', 'platform=macOS,arch=' + arch,
             '-derivedDataPath', os.path.join(work, 'derived'),
             # Checkouts and binary artifacts, kept for every app's next
             # build as Xcode keeps a project's (#188): most of the time.
             '-clonedSourcePackagesDirPath', os.path.join(cache, 'swiftpm-sources'),
             'SYMROOT=' + products,
             # Quoted: a list setting, which xcodebuild splits at spaces.
             'FRAMEWORK_SEARCH_PATHS="%s"' % os.path.realpath(os.path.dirname(os.path.dirname(flutter_framework))),
             'LD_RUNPATH_SEARCH_PATHS=@loader_path/../../..',
             'CODE_SIGNING_ALLOWED=NO', 'build'],
            cwd=os.path.join(packages_dir, SWIFT_FRAMEWORK), env=env,
            stdout=log, stderr=subprocess.STDOUT).returncode == 0
    release = os.path.join(products, 'Release')
    made_in = os.path.join(release, 'PackageFrameworks')
    framework = os.path.join(made_in, SWIFT_FRAMEWORK + '.framework')
    if not ok or not os.path.isdir(framework):
        # The log outlives the work folder, which goes.
        kept = os.path.join(out, 'build', entry['key'] + '.log')
        shutil.copyfile(log_path, kept)
        why = 'swift packages did not build; see ' + kept
        keep_failure(entry, why, kept)
        errors = error_lines(kept)
        culprits = {p['name'] for p in plugins
                    if "package '%s'" % p['name'] in errors
                    or os.path.realpath(p['package']) + os.sep in errors
                    or os.path.join(packages_dir, p['name']) + os.sep in errors}
        # Two that want versions of a third no one version gives (Firebase
        # and Google Sign-In, say): the side with fewer plugins tied to it
        # goes (#192).
        names = [p['name'] for p in plugins]
        sides = [n for n in dict.fromkeys(re.findall(r"'([\w-]+)' depends on", errors)) if n in names]
        if not culprits and sides:
            culprits = {min(sides, key=lambda n: len(family(n, names)))}
        # With them: a family half in pods would load its SDK twice.
        culprits = set().union(*(family(n, names) for n in culprits))
        drop(work)
        return why, culprits, kept
    os.makedirs(cache, exist_ok=True)
    staging = tempfile.mkdtemp(prefix=entry['key'] + '.partial-', dir=cache)
    shutil.copytree(framework, os.path.join(staging, SWIFT_FRAMEWORK + '.framework'), symlinks=True)
    # The packages' resource bundles, where Bundle.module looks: in the
    # framework that holds their code.
    resources = os.path.join(staging, SWIFT_FRAMEWORK + '.framework', 'Versions', 'A', 'Resources')
    os.makedirs(resources, exist_ok=True)
    for bundle in sorted(os.listdir(release)):
        if bundle.endswith('.bundle'):
            shutil.copytree(os.path.join(release, bundle), os.path.join(resources, bundle), symlinks=True)
    # Dynamic frameworks the packages bring sit beside it; static ones are
    # linked in already.
    made = [framework]
    for f in frameworks(made_in):
        path = os.path.join(made_in, f)
        if path == framework:
            continue
        kind = subprocess.run(['file', '-bL', binary_of(path)], capture_output=True, text=True).stdout
        if 'dynamically linked shared library' in kind:
            shutil.copytree(path, os.path.join(staging, f), symlinks=True)
            made.append(path)
    for path in vendored(made, [release]):
        target = os.path.join(staging, os.path.basename(path))
        if os.path.isdir(path):
            shutil.copytree(path, target, symlinks=True, dirs_exist_ok=True)
        else:
            shutil.copy2(path, target)
    settle(staging, os.path.join(cache, entry['key']), lambda: in_cache(entry))
    drop(work)
    return None, None, None


def error_lines(log):
    """The lines of [log] that say error:, with the indented ones after
    them: a resolution error names the package on the next line."""
    picked, inside = [], False
    for line in open(log, errors='replace'):
        if 'error:' in line:
            picked.append(line)
            inside = True
        elif inside and line.startswith((' ', '\t')):
            picked.append(line)
        else:
            inside = False
    return ''.join(picked)


